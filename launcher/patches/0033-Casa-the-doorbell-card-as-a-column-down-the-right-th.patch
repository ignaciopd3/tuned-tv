 final class Ha {
     /** LockEntityFeature.OPEN: the lock can unlatch, not just unlock. */
     private static final int LOCK_OPEN = 1;
+    /** Words in an opener's id or name that make it the building's door, not the home's (a Nuki Opener is a lock). */
+    private static final String[] GATE_WORDS = {"gate", "intercom", "opener", "building", "portal", "portero", "telefonillo",
+            "cancela", "verja", "edificio"};
 
     private Ha() {
     }
@@ -79,6 +83,32 @@ final class Ha {
         return attributes != null && (attributes.optInt("supported_features", 0) & LOCK_OPEN) != 0;
     }
 
+    /** True when this opener is the building's door: a button (Ring Intercom's) or one whose id or name says so. */
+    static boolean opensGate(String entityId, JSONObject attributes) {
+        if (entityId.startsWith("button.")) return true;
+        String said = (entityId + " " + friendlyName(entityId, attributes)).toLowerCase(Locale.ROOT);
+        for (String w : GATE_WORDS) if (said.contains(w)) return true;
+        return false;
+    }
+
+    /** What Home Assistant calls the entity, or its id without the domain. */
+    static String friendlyName(String entityId, JSONObject attributes) {
+        String name = attributes == null ? "" : attributes.optString("friendly_name", "");
+        return name.isEmpty() ? entityId.substring(entityId.indexOf('.') + 1).replace('_', ' ') : name;
+    }
+
+    /** The open buttons' texts: the gate or the door by kind; two of one kind on a doorbell go by their names. */
+    static String[] openLabels(boolean[] gate, String[] names, String gateText, String doorText, String namedFormat) {
+        int gates = 0;
+        for (boolean g : gate) if (g) gates++;
+        String[] out = new String[gate.length];
+        for (int i = 0; i < gate.length; i++) {
+            boolean shared = gate[i] ? gates > 1 : gate.length - gates > 1;
+            out[i] = shared ? String.format(namedFormat, names[i]) : gate[i] ? gateText : doorText;
+        }
+        return out;
+    }
+
     // ---- entity states ----
 
     /** One entity as Casa keeps it: its state and its attributes, updated in place by apply(). */
