     /**
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java b/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
index d48dd76..1fcc1aa 100644
--- a/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
+++ b/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
@@ -233,6 +233,9 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
     /** Optional time-of-day backdrop (config.xml, sky_intensity); 0 keeps it hidden. */
     private SkyView sky;
     private String vpnApp;
+    /** vpn_app_per_app, and whether the VPN that is up leaves Home out (so it is a per-app VPN, not the whole TV's). */
+    private String vpnAppPerApp;
+    private boolean perAppVpnUp;
     /** vpn_pill: the VPN shown as its own pill (btnVpn) instead of a badge in the network pill. Off with top_menu. */
     private boolean vpnPill;
     private TextView btnVpn;
@@ -626,6 +629,7 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
             date.setPadding(0, (int) (4 * density), 0, 0);
         }
         vpnApp = cfg.vpnApp;
+        vpnAppPerApp = cfg.vpnAppPerApp;
         vpnPill = cfg.vpnPill && !cfg.topMenu;
         btnVpn = findViewById(R.id.btnVpn);
         adbWarning = cfg.adbWarning;
@@ -3074,9 +3078,13 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
                 if (caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)) ethernet = true;
                 if (caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)) wifi = true;
             }
+            // A VPN for the whole TV is Home's own default network too; a per-app one (an app's built-in VPN) is not.
+            NetworkCapabilities own = cm != null ? cm.getNetworkCapabilities(cm.getActiveNetwork()) : null;
+            perAppVpnUp = vpn && (own == null || !own.hasTransport(NetworkCapabilities.TRANSPORT_VPN));
             if (!online) {
                 text = getString(R.string.offline);
                 vpn = false;
+                perAppVpnUp = false;
             } else if (ethernet) {
                 text = getString(R.string.ethernet);
                 icon = R.drawable.ic_ethernet;
@@ -3265,17 +3273,24 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
 
     /** vpn_app's launch intent, or null when none is set or it is not installed. */
     private Intent vpnAppIntent() {
-        if (vpnApp.isEmpty()) return null;
-        Intent i = getPackageManager().getLeanbackLaunchIntentForPackage(vpnApp);
-        return i != null ? i : getPackageManager().getLaunchIntentForPackage(vpnApp);
+        return launchIntent(vpnApp);
+    }
+
+    /** A package's launch intent (its TV one first), or null when the name is empty or it is not installed. */
+    private Intent launchIntent(String pkg) {
+        if (pkg.isEmpty()) return null;
+        Intent i = getPackageManager().getLeanbackLaunchIntentForPackage(pkg);
+        return i != null ? i : getPackageManager().getLaunchIntentForPackage(pkg);
     }
 
     /**
-     * vpn_pill: the VPN app, where it is switched on and off. Without one installed, the App library to pick from, or
+     * vpn_pill: the VPN app, where it is switched on and off: vpn_app_per_app while a per-app VPN is up (the one that
+     * switched it on), vpn_app otherwise. Without one installed, the App library to pick from, or
      * Android's VPN settings when the theme turned the library off.
      */
     private void openVpnPill() {
-        Intent i = vpnAppIntent();
+        Intent i = launchIntent(VpnBadge.appToOpen(perAppVpnUp, vpnApp, vpnAppPerApp));
+        if (i == null) i = vpnAppIntent();
         if (i != null || !appLibraryEnabled) {
             open(i != null ? i : systemIntent(Settings.ACTION_VPN_SETTINGS));
             return;
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/VpnBadge.java b/launcher/app/src/main/java/com/gathin/tvhome/VpnBadge.java
index be81332..31479ef 100644
--- a/launcher/app/src/main/java/com/gathin/tvhome/VpnBadge.java
+++ b/launcher/app/src/main/java/com/gathin/tvhome/VpnBadge.java
@@ -47,6 +47,14 @@ final class VpnBadge extends ReplacementSpan {
         return vpnUp ? PILL_UP : vpnAppInstalled ? PILL_OFF : PILL_HIDDEN;
     }
 
+    /**
+     * The app the VPN pill opens: vpn_app_per_app while the VPN that is up leaves Home out (a per-app VPN, such as a
+     * streaming app's built-in one; Android does not tell Home whose VPN it is), vpn_app otherwise.
+     */
+    static String appToOpen(boolean perAppVpnUp, String vpnApp, String perAppVpnApp) {
+        return perAppVpnUp && !perAppVpnApp.isEmpty() ? perAppVpnApp : vpnApp;
+    }
+
     /** icon_only_vpn: the closed lock while a VPN is up, the open lock while none is. */
     static int iconOnlyLock(boolean up) {
         return up ? R.drawable.ic_lock : R.drawable.ic_lock_open;
diff --git a/launcher/app/src/main/res/values/config.xml b/launcher/app/src/main/res/values/config.xml
index 620aa25..5d53598 100644
--- a/launcher/app/src/main/res/values/config.xml
+++ b/launcher/app/src/main/res/values/config.xml
@@ -299,6 +299,10 @@
          VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
          with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
     <string name="vpn_app" translatable="false"></string>
+    <!-- What the VPN pill opens instead of vpn_app while the VPN that is up leaves Home out: a per-app VPN, such as a
+         streaming app's built-in one that only carries that app (Android does not tell Home whose VPN it is, only
+         whether it covers Home). Empty: always vpn_app. -->
+    <string name="vpn_app_per_app" translatable="false"></string>
     <!-- The VPN as its own pill after the network pill, instead of a badge inside it: solid green with a lock while a
          VPN is up, solid red "VPN off" while none is and vpn_app is installed. Pressing it opens vpn_app (without it,
          the App library, or VPN settings when app_library is off), and the network pill then always opens Wi-Fi
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/VpnPillTest.java b/launcher/app/src/test/java/com/gathin/tvhome/VpnPillTest.java
index f657aad..6b81f22 100644
--- a/launcher/app/src/test/java/com/gathin/tvhome/VpnPillTest.java
+++ b/launcher/app/src/test/java/com/gathin/tvhome/VpnPillTest.java
@@ -23,6 +23,17 @@ public class VpnPillTest {
         assertEquals(R.drawable.ic_lock_open, VpnBadge.iconOnlyLock(false));
     }
 
+    @Test
+    public void aVpnThatLeavesHomeOutOpensThePerAppVpnApp() {
+        assertEquals("com.example.iptv", VpnBadge.appToOpen(true, "ch.protonvpn.android", "com.example.iptv"));
+    }
+
+    @Test
+    public void aVpnForTheWholeTvOrNoVpnOpensVpnApp() {
+        assertEquals("ch.protonvpn.android", VpnBadge.appToOpen(false, "ch.protonvpn.android", "com.example.iptv"));
+        assertEquals("ch.protonvpn.android", VpnBadge.appToOpen(true, "ch.protonvpn.android", ""));
+    }
+
     @Test
     public void hiddenWithNoVpnAndNoInstalledVpnApp() {
         assertEquals(VpnBadge.PILL_HIDDEN, VpnBadge.pillState(false, false));
