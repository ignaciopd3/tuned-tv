         this.adbWarning = adbWarning;
         this.headerCapsule = headerCapsule;
         this.topBarCapsule = topBarCapsule;
@@ -512,6 +515,7 @@ final class Config {
         boolean wallpaperCaptions = res.getBoolean(R.bool.wallpaper_captions);
         boolean tileMenu = res.getBoolean(R.bool.tile_menu);
         String vpn = res.getString(R.string.vpn_app).trim();
