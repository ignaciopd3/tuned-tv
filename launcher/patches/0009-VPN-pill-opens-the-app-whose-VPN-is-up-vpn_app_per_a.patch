                    int openOnStartNetworkWait, boolean openOnStartOnWake, boolean iconOnlyVpn, String clockFormat, boolean backOpensClock, boolean glowSnap,
                    boolean settingsKeyClearTask, String weatherApp, boolean adbWarning,
-                   boolean headerCapsule, boolean topBarCapsule) {
+                   boolean headerCapsule, boolean topBarCapsule, String vpnAppPerApp) {
         this.weatherApp = weatherApp;
