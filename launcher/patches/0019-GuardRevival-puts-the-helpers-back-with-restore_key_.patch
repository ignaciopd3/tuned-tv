     private boolean onStockHome;
     private BroadcastReceiver stockScreenOn;
     static final long COVER_MAX_MS = 1500;
+    /** How far back the front check looks: the last activity moved to the front is the one still there. */
+    private static final long FRONT_LOOKBACK_MS = 6 * 60 * 60 * 1000L;
     /** power_on_home: the Live TV package to send back to Home, empty when off; armed until this uptime or a key. */
     private String powerOnLiveTv = "";
     private long powerOnUntil;
@@ -223,8 +227,12 @@ public class HomeKeyService extends AccessibilityService {
                 stockHome.add(ri.activityInfo.name);
             }
