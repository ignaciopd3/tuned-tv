@@ -430,6 +438,34 @@ public class HomeKeyService extends AccessibilityService {
         }
     }
 
+    /** Connected while the stock home is already in front (ServiceRepair after a force stop, a late bind at boot):
+     *  no window event comes for it, and Home pressed there changes no window either. Fire OS keeps both Home
+     *  broadcasts to itself (CLOSE_SYSTEM_DIALOGS needs com.amazon.permission.ENABLE_KEYGUARD_FLAGS, and
+     *  com.amazon.tv.devicecontrol.HOME_PRESSED goes only to Amazon's receiver), so the stock home stayed until an
+     *  app was opened and closed. The last activity moved to the front says which screen it is: a package check
+     *  would not do, Amazon's Settings live in the same package as its home. Needs GET_USAGE_STATS (appops allow,
+     *  set by the installer); without it the query comes back empty and nothing happens. dumbtv's Keeper reads the
+     *  front activity the same way (github.com/humblemuzzu/dumbtv, MIT). */
+    private void redirectIfStockHomeInFront() {
+        try {
+            UsageStatsManager usage = getSystemService(UsageStatsManager.class);
+            if (usage == null) return;
+            long now = System.currentTimeMillis();
+            UsageEvents events = usage.queryEvents(now - FRONT_LOOKBACK_MS, now);
+            UsageEvents.Event event = new UsageEvents.Event();
+            String front = null;
+            while (events.hasNextEvent()) {
+                events.getNextEvent(event);
+                if (event.getEventType() == UsageEvents.Event.MOVE_TO_FOREGROUND) front = event.getClassName();
+            }
+            if (front == null || !stockHome.contains(front)) return;
+        } catch (RuntimeException unreadable) {
+            return;  // a firmware that refuses the query: the window events still redirect
+        }
+        onStockHome = true;
+        redirectStockHome();
+    }
+
     private void disarmStockHome() {
         handler.removeCallbacks(uncover);
         if (cover != null) {
