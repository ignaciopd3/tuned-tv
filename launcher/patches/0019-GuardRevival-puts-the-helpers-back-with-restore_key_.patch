From e21f80b7f5d4f80a7ad6f5e087296cf09e9f57dc Mon Sep 17 00:00:00 2001
From: ignaciopd3 <210892957+ignaciopd3@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:25:44 +0100
Subject: [PATCH 19/26] GuardRevival puts the helpers back with
 restore_key_services; stock_home_redirect checks the front on connect

On Fire OS Home is Amazon's, so after a force stop nothing started this launcher
again: Android had taken HomeKeyService off the accessibility list and the stock
home, ads and all, stayed until the helper was turned on over ADB (Fire TV Stick
4K Max, Fire OS 7.7.1.3). GuardRevival, which Android binds again after a force
stop, now also runs ServiceRepair.restore when restore_key_services is on.

The helper can come back while the stock home is already in front. No window
event comes for it, and Fire OS keeps both Home broadcasts to itself, so Home
pressed there did nothing. On connect, HomeKeyService now reads the last activity
moved to the front (UsageStats, GET_USAGE_STATS allowed by the installer) and
redirects when it is the stock home.
---
 launcher/app/src/main/AndroidManifest.xml     |  4 ++
 .../java/com/gathin/tvhome/GuardRevival.java  | 12 +++++-
 .../com/gathin/tvhome/HomeKeyService.java     | 40 ++++++++++++++++++-
 3 files changed, 52 insertions(+), 4 deletions(-)

diff --git a/launcher/app/src/main/AndroidManifest.xml b/launcher/app/src/main/AndroidManifest.xml
index c5a6c96..d64b47e 100644
--- a/launcher/app/src/main/AndroidManifest.xml
+++ b/launcher/app/src/main/AndroidManifest.xml
@@ -18,6 +18,10 @@
          list (ServiceRepair). Granted with pm grant by build-and-install when a helper is enabled. -->
     <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
         tools:ignore="ProtectedPermissions" />
+    <!-- stock_home_redirect (Fire OS): which activity is in front when HomeKeyService connects, so it can leave a
+         stock home that was already up. The installer allows it with appops set GET_USAGE_STATS allow. -->
+    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
+        tools:ignore="ProtectedPermissions" />
     <!-- YaOS (Yandex TV OS): HDMI, AV and the tuner all play in com.yandex.tv.live, whose activities require
          this permission (protection level normal, so it is granted at install). Ignored on other TVs. -->
     <uses-permission android:name="yandex.tv.permission.ACCESS_TV_SOURCE" />
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/GuardRevival.java b/launcher/app/src/main/java/com/gathin/tvhome/GuardRevival.java
