                     stopWaiting();
-                    GuardKeep.ensureHomeKey(GuardRevival.this);
+                    revive();
                 }
             };
             registerReceiver(unlocked, new IntentFilter(Intent.ACTION_USER_UNLOCKED));
             if (users.isUserUnlocked()) {
                 stopWaiting();
-                GuardKeep.ensureHomeKey(this);
+                revive();
             }
             return;
         }
+        revive();
+    }
+
+    /** The standby opt-in, and with restore_key_services the helpers a force stop took off the list. Where Home
+     *  is another app's (stock_home_redirect on Fire OS) nothing else starts this launcher after a force stop: the
+     *  stock home stayed, ads and all, until the helper was turned on again over ADB (Fire TV Stick 4K Max). */
+    private void revive() {
         GuardKeep.ensureHomeKey(this);
+        if (Config.load(this).restoreKeyServices) ServiceRepair.restore(this);
     }
 
     private void stopWaiting() {
