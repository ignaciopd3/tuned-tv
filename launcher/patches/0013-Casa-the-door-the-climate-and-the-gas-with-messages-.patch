@@ -0,0 +1,31 @@
+package io.github.ignaciopd3.casa;
+
+/**
+ * Which data point means what for each of Casa's devices, by number (local and MQTT for LAN devices) or by code
+ * (cloud status). From the devices' own specification (tuya_sharing local_strategy), read on 2026-11-19.
+ */
+final class Roles {
+    static final String CLIMA = "clima", PUERTA = "puerta", GAS = "gas";
+
+    enum Field { ON, TEMPERATURE, HUMIDITY, DOOR_OPEN, GAS }
+
+    private Roles() {
+    }
+
+    static Field field(String role, String dp) {
+        switch (role) {
+            case Devices.LUZ:
+            case Devices.CALEFACTOR:
+                return "1".equals(dp) || "switch_1".equals(dp) ? Field.ON : null;
+            case CLIMA:
+                if ("1".equals(dp) || "va_temperature".equals(dp)) return Field.TEMPERATURE;
+                return "2".equals(dp) || "va_humidity".equals(dp) || "humidity_value".equals(dp) ? Field.HUMIDITY : null;
+            case PUERTA:
+                return "1".equals(dp) || "doorcontact_state".equals(dp) ? Field.DOOR_OPEN : null;
+            case GAS:
+                return "2".equals(dp) || "gas_sensor_status".equals(dp) ? Field.GAS : null;
+            default:
+                return null;
+        }
+    }
+}
