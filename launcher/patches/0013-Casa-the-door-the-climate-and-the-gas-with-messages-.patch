new file mode 100644
index 0000000..651dc9c
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/GasWatch.java
@@ -0,0 +1,106 @@
+package io.github.ignaciopd3.casa;
+
+import java.io.IOException;
+import java.net.SocketTimeoutException;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Keeps a connection open to the gas sensor on the home network (protocol 3.4) and reports its state the moment it
+ * changes, with no internet involved. A heartbeat every 9 s keeps the sensor talking; any error closes the
+ * connection and retries after 10 s.
+ */
+final class GasWatch implements Runnable {
+    private static final Pattern GAS = Pattern.compile("\"2\"\s*:\s*\"([a-z]+)\"");
+    private static final long HEARTBEAT_MS = 9000, RETRY_MS = 10_000;
+
+    interface Listener {
+        void gas(String status);
+
+        void gasLink(boolean up);
+    }
+
+    interface Opener {
+        TuyaLocal.Transport open() throws IOException;
+    }
+
+    private final Devices.Device device;
+    private final Opener opener;
+    private final TuyaLocal.Random random;
+    private final Listener listener;
+    private volatile boolean stopped;
+
+    GasWatch(Devices.Device device, Opener opener, TuyaLocal.Random random, Listener listener) {
+        this.device = device;
+        this.opener = opener;
+        this.random = random;
+        this.listener = listener;
+    }
+
+    void stop() {
+        stopped = true;
+    }
+
+    @Override
+    public void run() {
+        while (!stopped) {
+            try (TuyaLocal.Transport t = opener.open()) {
+                byte[] session = negotiate34(t, device.key, random);
+                int seq = 3;
+                t.write(Frames.encode34(seq++, Frames.DP_QUERY_NEW, "{}".getBytes(StandardCharsets.UTF_8), session));
+                listener.gasLink(true);
+                long nextBeat = System.currentTimeMillis() + HEARTBEAT_MS;
+                byte[] beat = ("{\"gwId\":\"" + device.id + "\",\"devId\":\"" + device.id + "\"}").getBytes(StandardCharsets.UTF_8);
+                while (!stopped) {
+                    byte[] f = null;
+                    try {
+                        f = t.readFrame();
+                    } catch (SocketTimeoutException idle) {
+                        // nothing new: time for a heartbeat?
+                    }
+                    if (f != null) {
+                        String gas = gasStatus(Frames.decode34(f, session).payload);
+                        if (gas != null) listener.gas(gas);
+                    }
+                    if (System.currentTimeMillis() >= nextBeat) {
+                        t.write(Frames.encode34(seq++, Frames.HEART_BEAT, beat, session));
+                        nextBeat = System.currentTimeMillis() + HEARTBEAT_MS;
+                    }
+                }
+            } catch (IOException | RuntimeException e) {
+                listener.gasLink(false);
+                sleep(RETRY_MS);
+            }
+        }
+    }
+
+    /** The 3.4 handshake: nonces and HMACs as in 3.5, but ECB-encrypted, and the session key is one ECB block. */
+    static byte[] negotiate34(TuyaLocal.Transport t, byte[] key, TuyaLocal.Random random) throws IOException {
+        byte[] local = random.bytes(16);
+        t.write(Frames.encode34(1, Frames.SESS_KEY_NEG_START, local, key));
+        Frames.Message offer = Frames.decode34(t.readFrame(), key);
+        if (offer.cmd != Frames.SESS_KEY_NEG_RESP || offer.payload.length < 48) throw new IOException("no session offer");
+        byte[] remote = Arrays.copyOfRange(offer.payload, 0, 16);
+        if (!Arrays.equals(Frames.hmac(key, local), Arrays.copyOfRange(offer.payload, 16, 48))) {
+            throw new IOException("session offer failed its HMAC (wrong local key?)");
+        }
+        t.write(Frames.encode34(2, Frames.SESS_KEY_NEG_FINISH, Frames.hmac(key, remote), key));
+        return Frames.sessionKey34(key, local, remote);
+    }
+
+    /** "alarm" or "normal" from a status payload (data point 2), or null when it does not carry it. */
+    static String gasStatus(byte[] payload) {
+        Matcher m = GAS.matcher(new String(payload, StandardCharsets.UTF_8));
+        return m.find() ? m.group(1) : null;
+    }
+
+    private void sleep(long ms) {
+        try {
+            Thread.sleep(ms);
+        } catch (InterruptedException e) {
+            stopped = true;
+        }
+    }
+}
