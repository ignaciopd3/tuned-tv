@@ -112,4 +112,30 @@ public class FramesTest {
         f[35] ^= 1;
         assertThrows(java.io.IOException.class, () -> Frames.decode6699(f, hex(s.getString("sessionKey"))));
     }
+
+    @Test
+    public void v34FramesAreTheSameAsTinytuya() throws Exception {
+        JSONObject s = v.getJSONObject("v34");
+        byte[] session = hex(s.getString("sessionKey"));
+        for (String step : new String[] {"step1", "step3", "query", "heartbeat"}) {
+            JSONObject f = s.getJSONObject(step);
+            byte[] k = step.startsWith("step") ? key : session;
+            assertArrayEquals(step, hex(f.getString("frame")), Frames.encode34(f.getInt("seq"), f.getInt("cmd"), hex(f.getString("raw")), k));
+        }
+    }
+
+    @Test
+    public void v34HandshakeAndStatusDecode() throws Exception {
+        JSONObject s = v.getJSONObject("v34");
+        Frames.Message offer = Frames.decode34(hex(s.getJSONObject("step2").getString("frame")), key);
+        assertArrayEquals(hex(s.getString("remoteNonce")), Arrays.copyOfRange(offer.payload, 0, 16));
+        assertArrayEquals(Frames.hmac(key, hex(s.getString("localNonce"))), Arrays.copyOfRange(offer.payload, 16, 48));
+        byte[] session = Frames.sessionKey34(key, hex(s.getString("localNonce")), hex(s.getString("remoteNonce")));
+        assertArrayEquals(hex(s.getString("sessionKey")), session);
+        Frames.Message status = Frames.decode34(hex(s.getJSONObject("status").getString("frame")), session);
+        assertEquals(s.getJSONObject("status").getString("json"), new String(status.payload, StandardCharsets.UTF_8));
+        byte[] tampered = hex(s.getJSONObject("status").getString("frame"));
+        tampered[22] ^= 1;
+        assertThrows(java.io.IOException.class, () -> Frames.decode34(tampered, session));
