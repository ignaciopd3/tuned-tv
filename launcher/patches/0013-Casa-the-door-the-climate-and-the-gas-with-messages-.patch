+package io.github.ignaciopd3.casa;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/** Brings Casa back when the TV starts (needs APP_AUTO_START allow on TCL, which tools/launcher.sh grants). */
+public class BootReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) CasaService.start(context);
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CasaProvider.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CasaProvider.java
new file mode 100644
index 0000000..c386253
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CasaProvider.java
@@ -0,0 +1,60 @@
+package io.github.ignaciopd3.casa;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+
+/**
+ * The launcher row's data (content://io.github.ignaciopd3.casa.now/now), one row: luz and calefactor (1 on, 0 off,
+ * -1 unknown), temperature and humidity as shown ("20,3°", "66 %", "—"), and whether the cloud is connected. Read
+ * only, and only by apps holding Casa's signature permission (the launcher). Notifies on every change.
+ */
+public class CasaProvider extends ContentProvider {
+    static final String[] COLUMNS = {"luz", "calefactor", "temperature", "humidity", "cloud"};
+
+    @Override
+    public boolean onCreate() {
+        try {
+            CasaService.start(getContext());   // whoever asks first brings Casa up
+        } catch (RuntimeException notNow) {
+            // started again by the next query or by the TV coming on
+        }
+        return true;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] selectionArgs, String sortOrder) {
+        State s = CasaService.state;
+        MatrixCursor c = new MatrixCursor(COLUMNS, 1);
+        c.addRow(new Object[] {tri(s.luz), tri(s.calefactor), State.temperature(s.temperatureTenths),
+                State.humidity(s.humidity), s.cloudConnected ? 1 : 0});
+        c.setNotificationUri(getContext().getContentResolver(), CasaService.NOW);
+        return c;
+    }
+
+    private static int tri(Boolean b) {
+        return b == null ? -1 : b ? 1 : 0;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return "vnd.android.cursor.item/vnd.io.github.ignaciopd3.casa.now";
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        return null;
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        return 0;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        return 0;
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CasaService.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CasaService.java
new file mode 100644
index 0000000..d06dde2
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CasaService.java
@@ -0,0 +1,303 @@
+package io.github.ignaciopd3.casa;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.Service;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import java.security.SecureRandom;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.json.JSONException;
+
+/**
+ * Casa running: the cloud (status at start-up, then MQTT), the gas sensor on the home network, the door messages and
+ * the state the launcher row reads (CasaProvider). A foreground service, as TCL stops background work; it comes back
+ * with the TV (BootReceiver) and whenever any part of Casa starts.
+ */
+public class CasaService extends Service implements MqttWatch.Listener, GasWatch.Listener {
+    static final Uri NOW = Uri.parse("content://io.github.ignaciopd3.casa.now/now");
+    static final String ACTION_STATE = "io.github.ignaciopd3.casa.STATE", ACTION_RELOAD = "io.github.ignaciopd3.casa.RELOAD",
+            ACTION_SIMULATE = "io.github.ignaciopd3.casa.SIMULATE";
+    static final String EXTRA_ROLE = "role", EXTRA_ON = "on", EXTRA_WHAT = "what";
+    private static final long WARN_AFTER_MS = 5 * 60_000L, HEALTH_EVERY_MS = 60_000L;
+    private static final String CHANNEL = "casa";
+
+    /** What Casa knows now; CasaProvider answers from it. Replaced, never mutated, so readers see a whole state. */
+    static volatile State state = new State();
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final DoorAlerts door = new DoorAlerts();
+    private Overlay overlay;
+    private MqttWatch mqtt;
+    private GasWatch gasWatch;
+    private String lastGas;
+    private long cloudDownSince, gasDownSince;
+    private boolean cloudWarned, gasWarned, doorKnown;
+
+    private final Runnable doorTick = new Runnable() {
+        @Override
+        public void run() {
+            show(door.onTick(System.currentTimeMillis()));
+            scheduleDoorTick();
+        }
+    };
+    private final Runnable health = new Runnable() {
+        @Override
+        public void run() {
+            checkHealth();
+            main.postDelayed(this, HEALTH_EVERY_MS);
+        }
+    };
+    private final BroadcastReceiver screenOn = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context c, Intent i) {
+            show(door.onScreenOn(System.currentTimeMillis()));
+        }
+    };
+
+    static void start(Context ctx) {
+        ctx.startForegroundService(new Intent(ctx, CasaService.class));
+    }
+
+    /** A plug switched from the TV (ToggleService): the row shows it at once, before the cloud says so. */
+    static void reportSwitch(Context ctx, String role, boolean on) {
+        ctx.startForegroundService(new Intent(ctx, CasaService.class).setAction(ACTION_STATE)
+                .putExtra(EXTRA_ROLE, role).putExtra(EXTRA_ON, on));
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        NotificationManager nm = getSystemService(NotificationManager.class);
+        nm.createNotificationChannel(new NotificationChannel(CHANNEL, getString(R.string.app_name), NotificationManager.IMPORTANCE_MIN));
+        Notification n = new Notification.Builder(this, CHANNEL).setSmallIcon(R.drawable.ic_bulb)
+                .setContentTitle(getString(R.string.app_name)).setContentText(getString(R.string.service_running)).build();
+        startForeground(1, n);
+        overlay = new Overlay(this);
+        registerReceiver(screenOn, new IntentFilter(Intent.ACTION_SCREEN_ON));
+        startWatchers();
+        main.postDelayed(health, HEALTH_EVERY_MS);
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        String action = intent == null ? null : intent.getAction();
+        if (ACTION_STATE.equals(action)) {
+            apply(intent.getStringExtra(EXTRA_ROLE), Roles.Field.ON, intent.getBooleanExtra(EXTRA_ON, false));
+        } else if (ACTION_RELOAD.equals(action)) {
+            startWatchers();
+        } else if (ACTION_SIMULATE.equals(action)) {
+            simulate(intent.getStringExtra(EXTRA_WHAT));
+        }
+        return START_STICKY;
+    }
+
+    // ---- watchers ----
+
+    private void startWatchers() {
+        stopWatchers();
+        Devices.Device gas = Devices.load(this, Roles.GAS);
+        if (gas != null && gas.local()) {
+            SecureRandom r = new SecureRandom();
+            gasWatch = new GasWatch(gas, () -> new TuyaLocal.SocketTransport(gas.ip, 3000), n -> {
+                byte[] b = new byte[n];
+                r.nextBytes(b);
+                return b;
+            }, this);
+            new Thread(gasWatch, "casa-gas").start();
+        }
+        CloudApi.Session session = Devices.loadSession(this);
+        Map<String, String> roleById = new LinkedHashMap<>();
+        for (String role : Devices.ROLES) {
+            Devices.Device d = Devices.load(this, role);
+            if (d != null) roleById.put(d.id, role);
+        }
+        if (session != null && !roleById.isEmpty()) {
+            CloudApi api = CloudApi.forTv(session, renewed -> {
+                try {
+                    Devices.saveSession(this, renewed);
+                } catch (JSONException ignored) {
+                    // the old session stays; the next renewal tries again
+                }
+            });
+            mqtt = new MqttWatch(api, roleById, this);
+            new Thread(mqtt, "casa-cloud").start();
+        }
+    }
+
+    private void stopWatchers() {
+        if (mqtt != null) mqtt.stop();
+        if (gasWatch != null) gasWatch.stop();
+        mqtt = null;
+        gasWatch = null;
+    }
+
+    // ---- reports (from worker threads) ----
+
+    @Override
+    public void report(String role, String dp, Object value) {
+        Roles.Field f = Roles.field(role, dp);
+        if (f != null) main.post(() -> apply(role, f, value));
+    }
+
+    @Override
+    public void cloudLink(boolean up) {
+        main.post(() -> {
+            cloudDownSince = up ? 0 : (cloudDownSince == 0 ? System.currentTimeMillis() : cloudDownSince);
+            if (up) cloudWarned = false;
+            State s = copy();
+            s.cloudConnected = up;
+            publish(s);
+        });
+    }
+
+    @Override
+    public void gas(String status) {
+        main.post(() -> apply(Roles.GAS, Roles.Field.GAS, status));
+    }
+
+    @Override
+    public void gasLink(boolean up) {
+        main.post(() -> {
+            gasDownSince = up ? 0 : (gasDownSince == 0 ? System.currentTimeMillis() : gasDownSince);
+            if (up) gasWarned = false;
+        });
+    }
+
+    /** One reading, on the main thread: the state for the row, and the door and gas messages. */
+    private void apply(String role, Roles.Field f, Object value) {
+        long now = System.currentTimeMillis();
+        State s = copy();
+        switch (f) {
+            case ON:
+                if (Devices.LUZ.equals(role)) s.luz = asBool(value);
+                else s.calefactor = asBool(value);
+                break;
+            case TEMPERATURE:
+                s.temperatureTenths = asInt(value);
+                break;
+            case HUMIDITY:
+                s.humidity = asInt(value);
+                break;
+            case DOOR_OPEN:
+                boolean open = Boolean.TRUE.equals(asBool(value));
+                s.doorOpen = open;
+                if (!doorKnown) {
+                    door.init(open, now);   // the first reading only learns the state
+                    doorKnown = true;
+                } else {
+                    show(door.onDoor(open, now));
+                }
+                scheduleDoorTick();
+                break;
+            case GAS:
+                String gas = String.valueOf(value);
+                s.gas = gas;
+                if ("alarm".equals(gas) && !"alarm".equals(lastGas)) overlay.showGas();
+                if (!"alarm".equals(gas) && "alarm".equals(lastGas)) overlay.gasCleared();
+                lastGas = gas;
+                break;
+            default:
+                break;
+        }
+        publish(s);
+    }
+
+    private void show(DoorAlerts.Alert a) {
+        if (a == null) return;
+        boolean reminder = a.title.startsWith("La puerta sigue");
+        int color = a.closed ? Overlay.GREEN : Overlay.AMBER;
+        int icon = a.closed ? R.drawable.ic_check : reminder ? R.drawable.ic_clock : R.drawable.ic_door;
+        overlay.showSmall(color, icon, a.title, a.sub, a.closed ? 4000 : 5000);
+    }
+
+    private void scheduleDoorTick() {
+        main.removeCallbacks(doorTick);
+        long at = door.nextTickAt();
+        if (at > 0) main.postDelayed(doorTick, Math.max(1000, at - System.currentTimeMillis()));
+    }
+
+    /** A message of its own when the cloud or the gas sensor has been unreachable for five minutes, once per outage. */
+    private void checkHealth() {
+        long now = System.currentTimeMillis();
+        if (mqtt != null && cloudDownSince > 0 && now - cloudDownSince > WARN_AFTER_MS && !cloudWarned) {
+            cloudWarned = true;
+            overlay.showSmall(Overlay.GREY, R.drawable.ic_info, getString(R.string.cloud_down), getString(R.string.cloud_down_sub), 8000);
+        }
+        if (gasWatch != null && gasDownSince > 0 && now - gasDownSince > WARN_AFTER_MS && !gasWarned) {
+            gasWarned = true;
+            overlay.showSmall(Overlay.GREY, R.drawable.ic_info, getString(R.string.gas_down), getString(R.string.gas_down_sub), 8000);
+        }
+    }
+
+    /** ADB-only tests of the messages (ImportActivity --es simulate ...). */
+    private void simulate(String what) {
+        long now = System.currentTimeMillis();
+        if ("gas".equals(what)) {
+            apply(Roles.GAS, Roles.Field.GAS, "alarm");
+        } else if ("gas-normal".equals(what)) {
+            apply(Roles.GAS, Roles.Field.GAS, "normal");
+        } else if ("puerta".equals(what)) {
+            show(new DoorAlerts.Alert(false, "Puerta abierta", "El sensor de la puerta se ha abierto"));
+        } else if ("sigue".equals(what)) {
+            show(new DoorAlerts.Alert(false, "La puerta sigue abierta", "Desde hace 5 min · te lo recuerdo cada 5 min"));
+        } else if ("cerrada".equals(what)) {
+            show(new DoorAlerts.Alert(true, "Puerta cerrada", "Estuvo abierta " + DoorAlerts.duration(7 * 60_000L)));
+        }
+    }
+
+    private State copy() {
+        State o = state, s = new State();
+        s.luz = o.luz;
+        s.calefactor = o.calefactor;
+        s.doorOpen = o.doorOpen;
+        s.temperatureTenths = o.temperatureTenths;
+        s.humidity = o.humidity;
+        s.gas = o.gas;
+        s.cloudConnected = o.cloudConnected;
+        return s;
+    }
+
+    private void publish(State s) {
+        state = s;
+        getContentResolver().notifyChange(NOW, null);
+    }
+
+    private static Boolean asBool(Object v) {
+        if (v instanceof Boolean) return (Boolean) v;
+        if (v == null) return null;
+        String s = String.valueOf(v);
+        return "true".equalsIgnoreCase(s) || "1".equals(s);
+    }
+
+    private static Integer asInt(Object v) {
+        if (v instanceof Number) return ((Number) v).intValue();
+        try {
+            return v == null ? null : Integer.valueOf(String.valueOf(v).trim());
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    @Override
+    public void onDestroy() {
+        stopWatchers();
+        main.removeCallbacksAndMessages(null);
+        overlay.dismissGas();
+        unregisterReceiver(screenOn);
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CloudApi.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/CloudApi.java
