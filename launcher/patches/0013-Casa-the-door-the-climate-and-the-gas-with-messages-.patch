diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/MqttWatch.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/MqttWatch.java
new file mode 100644
index 0000000..9e5c7a9
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/MqttWatch.java
@@ -0,0 +1,134 @@
+package io.github.ignaciopd3.casa;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import org.eclipse.paho.client.mqttv3.IMqttDeliveryToken;
+import org.eclipse.paho.client.mqttv3.MqttCallback;
+import org.eclipse.paho.client.mqttv3.MqttClient;
+import org.eclipse.paho.client.mqttv3.MqttConnectOptions;
+import org.eclipse.paho.client.mqttv3.MqttMessage;
+import org.eclipse.paho.client.mqttv3.persist.MemoryPersistence;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * The cloud side: the devices' status at start-up, then Tuya's MQTT reports as they happen (tuya_sharing.mq). The
+ * credentials expire, so it reconnects with fresh ones a minute before; a dropped connection retries with a growing
+ * pause (up to a minute), so a broken internet never turns into a request storm.
+ */
+final class MqttWatch implements Runnable {
+    interface Listener {
+        void report(String role, String dp, Object value);
+
+        void cloudLink(boolean up);
+    }
+
+    private final CloudApi api;
+    private final Map<String, String> roleById;
+    private final Listener listener;
+    private volatile boolean stopped;
+    private volatile CountDownLatch done;
+
+    MqttWatch(CloudApi api, Map<String, String> roleById, Listener listener) {
+        this.api = api;
+        this.roleById = roleById;
+        this.listener = listener;
+    }
+
+    void stop() {
+        stopped = true;
+        CountDownLatch d = done;
+        if (d != null) d.countDown();
+    }
+
+    @Override
+    public void run() {
+        long backoff = 1000;
+        while (!stopped) {
+            MqttClient client = null;
+            try {
+                List<String> ids = new ArrayList<>(roleById.keySet());
+                JSONArray devices = api.devicesDetail(ids);
+                for (int i = 0; i < devices.length(); i++) {
+                    JSONObject d = devices.getJSONObject(i);
+                    String role = roleById.get(d.optString("id"));
+                    JSONArray status = d.optJSONArray("status");
+                    for (int j = 0; role != null && status != null && j < status.length(); j++) {
+                        JSONObject s = status.getJSONObject(j);
+                        if (s.has("code") && s.has("value")) listener.report(role, s.getString("code"), s.get("value"));
+                    }
+                }
+                JSONObject cfg = api.mqttConfig();
+                done = new CountDownLatch(1);
+                CountDownLatch lost = done;
+                client = new MqttClient(cfg.getString("url"), cfg.getString("clientId"), new MemoryPersistence());
+                client.setCallback(new MqttCallback() {
+                    @Override
+                    public void connectionLost(Throwable cause) {
+                        lost.countDown();
+                    }
+
+                    @Override
+                    public void messageArrived(String topic, MqttMessage message) {
+                        for (Reports.Change c : Reports.parse(new String(message.getPayload(), StandardCharsets.UTF_8))) {
+                            String role = roleById.get(c.devId);
+                            if (role != null) listener.report(role, c.dp, c.value);
+                        }
+                    }
+
+                    @Override
+                    public void deliveryComplete(IMqttDeliveryToken token) {
+                    }
+                });
+                MqttConnectOptions o = new MqttConnectOptions();
+                o.setUserName(cfg.getString("username"));
+                o.setPassword(cfg.getString("password").toCharArray());
+                o.setCleanSession(true);
+                o.setAutomaticReconnect(false);
+                o.setKeepAliveInterval(60);
+                o.setConnectionTimeout(15);
+                client.connect(o);
+                String sub = cfg.getJSONObject("topic").getJSONObject("devId").getString("sub");
+                for (String id : ids) {
+                    String base = sub.replace("{devId}", id);
+                    client.subscribe(base + "/pen", 0);   // devices that also speak LAN report here, by data point
+                    client.subscribe(base + "/sta", 0);
+                }
+                listener.cloudLink(true);
+                long renewIn = Math.max(60, cfg.optLong("expireTime", 7200) - 60);
+                boolean dropped = lost.await(renewIn, TimeUnit.SECONDS);
+                backoff = dropped && !stopped ? Math.min(backoff * 2, 60_000) : 1000;
+                if (dropped && !stopped) listener.cloudLink(false);
+            } catch (Exception e) {
+                listener.cloudLink(false);
+                pause(backoff);
+                backoff = Math.min(backoff * 2, 60_000);
+            } finally {
+                if (client != null) {
+                    try {
+                        client.disconnectForcibly(1000, 1000);
+                    } catch (Exception ignored) {
+                        // already gone
+                    }
+                    try {
+                        client.close();
+                    } catch (Exception ignored) {
+                        // already closed
+                    }
+                }
+            }
+        }
+    }
+
+    private void pause(long ms) {
+        try {
+            Thread.sleep(ms);
+        } catch (InterruptedException e) {
+            stopped = true;
+        }
+    }
+}
