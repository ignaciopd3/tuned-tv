diff --git a/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/CloudApiTest.java b/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/CloudApiTest.java
new file mode 100644
index 0000000..1b2ad91
--- /dev/null
+++ b/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/CloudApiTest.java
@@ -0,0 +1,151 @@
+package io.github.ignaciopd3.casa;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/** CloudApi's signing and encryption against the official SDK's (tuya_sharing.customerapi, vectors.json "cloud"). */
+public class CloudApiTest {
+    private static JSONObject c;
+
+    @BeforeClass
+    public static void load() throws Exception {
+        try (InputStream in = CloudApiTest.class.getResourceAsStream("/vectors.json")) {
+            c = new JSONObject(new String(in.readAllBytes(), StandardCharsets.UTF_8)).getJSONObject("cloud");
+        }
+    }
+
+    private static Map<String, String> headers() throws Exception {
+        Map<String, String> h = new LinkedHashMap<>();
+        h.put("X-appKey", c.getString("clientId"));
+        h.put("X-requestId", c.getString("rid"));
+        h.put("X-sid", "");
+        h.put("X-time", c.getString("time"));
+        h.put("X-token", c.getString("accessToken"));
+        return h;
+    }
+
+    @Test
+    public void keysMatchTheSdk() throws Exception {
+        String hashKey = CloudApi.hashKey(c.getString("rid"), c.getString("refreshToken"));
+        assertEquals(c.getString("hashKey"), hashKey);
+        assertEquals(c.getString("secret"), CloudApi.secret(c.getString("rid"), hashKey));
+    }
+
+    @Test
+    public void encryptionMatchesTheSdk() throws Exception {
+        assertEquals(c.getString("queryEnc"), CloudApi.encdata(c.getString("queryJson"), c.getString("secret"), c.getString("nonce")));
+        assertEquals(c.getString("bodyEnc"), CloudApi.encdata(c.getString("bodyJson"), c.getString("secret"), c.getString("nonce")));
+        assertEquals(c.getString("resultPlain"), CloudApi.decryptResult(c.getString("result"), c.getString("secret")));
+    }
+
+    @Test
+    public void signaturesMatchTheSdk() throws Exception {
+        assertEquals(c.getString("signGet"), CloudApi.sign(c.getString("hashKey"), headers(), c.getString("queryEnc"), ""));
+        assertEquals(c.getString("signPost"), CloudApi.sign(c.getString("hashKey"), headers(), "", c.getString("bodyEnc")));
+    }
+
+    /** A cloud that checks each request's signature and answers with an encrypted result, like Tuya's. */
+    static final class FakeCloud implements CloudApi.Http {
+        final List<String> paths = new ArrayList<>();
+        String nextRefresh = "refresh2";
+
+        @Override
+        public String send(String method, String url, Map<String, String> h, String body) throws IOException {
+            String path = url.replaceFirst("^https://[^/]+", "").replaceFirst("\\?.*$", "");
+            paths.add(method + " " + path);
+            try {
+                String rid = h.get("X-requestId");
+                String refresh = path.startsWith("/v1.0/m/token/") ? path.substring("/v1.0/m/token/".length()) : currentRefresh;
+                String hashKey = CloudApi.hashKey(rid, refresh);
+                String query = url.contains("?encdata=") ? java.net.URLDecoder.decode(url.substring(url.indexOf("?encdata=") + 9), "UTF-8") : "";
+                String bodyEnc = body == null ? "" : new JSONObject(body).optString("encdata", "");
+                if (!CloudApi.sign(hashKey, h, query, bodyEnc).equals(h.get("X-sign"))) return "{\"success\":false,\"code\":-9999999,\"msg\":\"sign invalid\"}";
+                String plain;
+                if (path.startsWith("/v1.0/m/token/")) {
+                    plain = "{\"accessToken\":\"access2\",\"refreshToken\":\"" + nextRefresh + "\",\"expireTime\":7200,\"uid\":\"u1\"}";
+                    currentRefresh = nextRefresh;
+                } else if (path.equals("/v1.0/m/life/ha/devices/detail")) {
+                    plain = "[{\"id\":\"d1\",\"online\":true,\"status\":[{\"code\":\"switch_1\",\"value\":true}]}]";
+                } else {
+                    plain = "{\"url\":\"ssl://m1.example:8883\",\"clientId\":\"c\",\"username\":\"u\",\"password\":\"p\",\"expireTime\":7200,"
+                            + "\"topic\":{\"devId\":{\"sub\":\"smart/device/out/{devId}\"},\"ownerId\":{\"sub\":\"o/{ownerId}\"}}}";
+                }
+                String secret = CloudApi.secret(rid, hashKey);
+                byte[] nonce = "0123456789ab".getBytes(StandardCharsets.US_ASCII);
+                javax.crypto.Cipher ci = javax.crypto.Cipher.getInstance("AES/GCM/NoPadding");
+                ci.init(javax.crypto.Cipher.ENCRYPT_MODE, new javax.crypto.spec.SecretKeySpec(secret.getBytes(StandardCharsets.US_ASCII), "AES"),
+                        new javax.crypto.spec.GCMParameterSpec(128, nonce));
+                byte[] ct = ci.doFinal(plain.getBytes(StandardCharsets.UTF_8));
+                byte[] all = new byte[12 + ct.length];
+                System.arraycopy(nonce, 0, all, 0, 12);
+                System.arraycopy(ct, 0, all, 12, ct.length);
+                return "{\"success\":true,\"t\":1700000100000,\"result\":\"" + java.util.Base64.getEncoder().encodeToString(all) + "\"}";
+            } catch (Exception e) {
+                throw new IOException(e);
+            }
+        }
+
+        String currentRefresh = "refresh1";
+    }
+
+    private static CloudApi.Session session(long expireAt) {
+        return new CloudApi.Session("user", "term", "https://apigw.example", "access1", "refresh1", "u1", expireAt);
+    }
+
+    @Test
+    public void aSignedRequestReturnsTheDecryptedResult() throws Exception {
+        FakeCloud cloud = new FakeCloud();
+        CloudApi api = new CloudApi(session(Long.MAX_VALUE), cloud, () -> 1700000000000L, s -> { });
+        JSONArray devices = api.devicesDetail(List.of("d1", "d2"));
+        assertEquals("d1", devices.getJSONObject(0).getString("id"));
+        assertEquals("ssl://m1.example:8883", api.mqttConfig().getString("url"));
+        assertEquals(List.of("GET /v1.0/m/life/ha/devices/detail", "POST /v1.0/m/life/ha/access/config"), cloud.paths);
+    }
+
+    @Test
+    public void anExpiringSessionIsRenewedFirstAndSaved() throws Exception {
+        FakeCloud cloud = new FakeCloud();
+        CloudApi.Session[] saved = {null};
+        CloudApi api = new CloudApi(session(1700000030000L), cloud, () -> 1700000000000L, s -> saved[0] = s);
+        api.devicesDetail(List.of("d1"));
+        assertEquals("GET /v1.0/m/token/refresh1", cloud.paths.get(0));
+        assertEquals("refresh2", saved[0].refreshToken);
+        assertEquals(1700000100000L + 7200_000L, saved[0].expireAtMs);
+        assertFalse(cloud.paths.stream().anyMatch(p -> p.contains("terminal/expire")));
+    }
+
+    @Test
+    public void aRefusedRequestSaysWhy() {
+        CloudApi api = new CloudApi(session(Long.MAX_VALUE), (m, u, h, b) -> "{\"success\":false,\"code\":1010,\"msg\":\"token invalid\"}",
+                () -> 1L, s -> { });
+        IOException e = assertThrows(IOException.class, () -> api.devicesDetail(List.of("d1")));
+        assertTrue(e.getMessage().contains("token invalid"));
+    }
+
+    @Test
+    public void theSessionSurvivesAJsonRoundTrip() throws Exception {
+        CloudApi.Session s = session(123L);
+        CloudApi.Session back = CloudApi.Session.fromJson(s.toJson());
+        assertEquals(s.refreshToken, back.refreshToken);
+        assertEquals(123L, back.expireAtMs);
+        CloudApi.Session fromPc = CloudApi.Session.fromJson(new JSONObject()
+                .put("user_code", "uc").put("terminal_id", "t").put("endpoint", "https://e")
+                .put("token", new JSONObject().put("access_token", "a").put("refresh_token", "r").put("uid", "x")
+                        .put("t", 1000L).put("expire_time", 7200)).toString());
+        assertEquals(1000L + 7200_000L, fromPc.expireAtMs);
+    }
+}
diff --git a/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/FramesTest.java b/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/FramesTest.java
