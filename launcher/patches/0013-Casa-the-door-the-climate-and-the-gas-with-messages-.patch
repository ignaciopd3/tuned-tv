+package io.github.ignaciopd3.casa;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.Base64;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import javax.crypto.Cipher;
+import javax.crypto.Mac;
+import javax.crypto.spec.GCMParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * Tuya's device-sharing cloud (the one Home Assistant uses), ported from tuya_sharing.customerapi and checked against
+ * it (CloudApiTest). Each request: a fresh request id, a secret derived from it and the refresh token, parameters and
+ * body AES-GCM-encrypted into "encdata", an HMAC signature over the headers and the encrypted data. Never calls
+ * /v1.0/m/token/terminal/expire: that logs the TV out.
+ */
+final class CloudApi {
+    static final String CLIENT_ID = "HA_3y9q4ak7g4ephrvke";   // Home Assistant's public registration
+    private static final String NONCE_CHARS = "ABCDEFGHJKMNPQRSTWXYZabcdefhijkmnprstwxyz2345678";
+    private static final int TIMEOUT_MS = 8000;
+
+    /** How a request leaves the TV: HttpURLConnection there, a fake cloud in the tests. */
+    interface Http {
+        String send(String method, String url, Map<String, String> headers, String body) throws IOException;
+    }
+
+    /** The TV's own session, opened by the PC with a QR code made for the TV (casa_probe.py tv-login). */
+    static final class Session {
+        final String userCode, terminalId, endpoint, accessToken, refreshToken, uid;
+        final long expireAtMs;
+
+        Session(String userCode, String terminalId, String endpoint, String accessToken, String refreshToken, String uid,
+                long expireAtMs) {
+            this.userCode = userCode;
+            this.terminalId = terminalId;
+            this.endpoint = endpoint;
+            this.accessToken = accessToken;
+            this.refreshToken = refreshToken;
+            this.uid = uid;
+            this.expireAtMs = expireAtMs;
+        }
+
+        String toJson() throws JSONException {
+            return new JSONObject().put("userCode", userCode).put("terminalId", terminalId).put("endpoint", endpoint)
+                    .put("accessToken", accessToken).put("refreshToken", refreshToken).put("uid", uid)
+                    .put("expireAtMs", expireAtMs).toString();
+        }
+
+        /** Its own format, or the PC's (the SDK's login result: user_code, terminal_id, endpoint, token{...}). */
+        static Session fromJson(String json) throws JSONException {
+            JSONObject o = new JSONObject(json);
+            if (o.has("token")) {
+                JSONObject t = o.getJSONObject("token");
+                return new Session(o.getString("user_code"), o.getString("terminal_id"), o.getString("endpoint"),
+                        t.getString("access_token"), t.getString("refresh_token"), t.optString("uid", ""),
+                        t.getLong("t") + t.getLong("expire_time") * 1000L);
+            }
+            return new Session(o.getString("userCode"), o.getString("terminalId"), o.getString("endpoint"),
+                    o.getString("accessToken"), o.getString("refreshToken"), o.optString("uid", ""), o.getLong("expireAtMs"));
+        }
+    }
+
+    private Session session;
+    private final Http http;
+    private final LongSupplier clockMs;
+    private final Consumer<Session> onRenewed;
+    private final SecureRandom random = new SecureRandom();
+    private boolean renewing;
+
+    CloudApi(Session session, Http http, LongSupplier clockMs, Consumer<Session> onRenewed) {
+        this.session = session;
+        this.http = http;
+        this.clockMs = clockMs;
+        this.onRenewed = onRenewed;
+    }
+
+    static CloudApi forTv(Session session, Consumer<Session> onRenewed) {
+        return new CloudApi(session, CloudApi::urlConnection, System::currentTimeMillis, onRenewed);
+    }
+
+    /** The devices' details and status ([{id, online, status:[{code, value}]}]). */
+    JSONArray devicesDetail(List<String> ids) throws IOException {
+        Object r = request("GET", "/v1.0/m/life/ha/devices/detail", obj("devIds", String.join(",", ids)), null);
+        if (!(r instanceof JSONArray)) throw new IOException("unexpected devices answer");
+        return (JSONArray) r;
+    }
+
+    /** Fresh MQTT credentials: url, clientId, username, password, expireTime (s), topic.devId.sub. */
+    JSONObject mqttConfig() throws IOException {
+        Object r = request("POST", "/v1.0/m/life/ha/access/config", null, obj("linkId", "casa-tv." + UUID.randomUUID()));
