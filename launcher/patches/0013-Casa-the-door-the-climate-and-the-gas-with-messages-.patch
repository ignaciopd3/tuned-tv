+        if (len < 40 || 16 + len > frame.length) throw new IOException("bad 3.4 length");
+        int end = 16 + len;
+        if (b.getInt(end - 4) != SUFFIX_55AA) throw new IOException("bad 3.4 suffix");
+        if (!java.security.MessageDigest.isEqual(hmac(key, Arrays.copyOf(frame, end - 36)),
+                Arrays.copyOfRange(frame, end - 36, end - 4))) {
+            throw new IOException("bad 3.4 hmac");
+        }
+        int retcode = b.getInt(16);
+        byte[] enc = Arrays.copyOfRange(frame, 20, end - 36);
+        byte[] payload;
+        try {
+            payload = enc.length == 0 ? enc : aesEcb(Cipher.DECRYPT_MODE, key, enc);
+        } catch (IllegalStateException e) {
+            throw new IOException("3.4 payload does not decrypt", e);
+        }
+        if (payload.length >= VERSION_HEADER && payload[0] == '3' && payload[1] == '.') {
+            payload = Arrays.copyOfRange(payload, VERSION_HEADER, payload.length);
+        }
+        return new Message(seq, cmd, retcode, payload);
+    }
+
+    /** The 3.4 session key: local XOR remote nonce, encrypted with the local key (one ECB block, no padding). */
+    static byte[] sessionKey34(byte[] localKey, byte[] localNonce, byte[] remoteNonce) {
+        byte[] x = new byte[16];
+        for (int i = 0; i < 16; i++) x[i] = (byte) (localNonce[i] ^ remoteNonce[i]);
+        try {
+            Cipher c = Cipher.getInstance("AES/ECB/NoPadding");
+            c.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(localKey, "AES"));
+            return c.doFinal(x);
+        } catch (GeneralSecurityException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
     // ---- 3.5 ----
 
     /** "3.5" and 12 zero bytes in front of a command that carries the protocol header (CONTROL_NEW does). */
