@@ -0,0 +1,76 @@
+package io.github.ignaciopd3.casa;
+
+/**
+ * What the door sensor's changes should say: "Puerta abierta", then "La puerta sigue abierta" every five minutes
+ * while it stays open (and when the TV is switched on with it open), and "Puerta cerrada" with how long it was open.
+ * The first reading only learns the state; repeated reports of the same state say nothing.
+ */
+class DoorAlerts {
+    static final long REMIND_MS = 5 * 60_000L;
+
+    static final class Alert {
+        final boolean closed;
+        final String title, sub;
+
+        Alert(boolean closed, String title, String sub) {
+            this.closed = closed;
+            this.title = title;
+            this.sub = sub;
+        }
+    }
+
+    private Boolean open;
+    private long openedAt, lastReminderAt;
+
+    /** The state at start-up (from the cloud), without a message. */
+    void init(boolean isOpen, long now) {
+        open = isOpen;
+        openedAt = now;
+        lastReminderAt = now;
+    }
+
+    Alert onDoor(boolean isOpen, long now) {
+        if (open == null) {
+            init(isOpen, now);
+            return null;
+        }
+        if (open == isOpen) return null;
+        open = isOpen;
+        if (isOpen) {
+            openedAt = now;
+            lastReminderAt = now;
+            return new Alert(false, "Puerta abierta", "El sensor de la puerta se ha abierto");
+        }
+        return new Alert(true, "Puerta cerrada", "Estuvo abierta " + duration(now - openedAt));
+    }
+
+    /** Called at nextTickAt(): the five-minute reminder while the door stays open. */
+    Alert onTick(long now) {
+        if (!Boolean.TRUE.equals(open) || now - lastReminderAt < REMIND_MS) return null;
+        lastReminderAt = now;
+        return stillOpen(now);
+    }
+
+    Alert onScreenOn(long now) {
+        return Boolean.TRUE.equals(open) ? stillOpen(now) : null;
+    }
+
+    /** When the next reminder is due, or -1 while the door is closed. */
+    long nextTickAt() {
+        return Boolean.TRUE.equals(open) ? lastReminderAt + REMIND_MS : -1;
+    }
+
+    private Alert stillOpen(long now) {
+        long min = Math.max(1, (now - openedAt) / 60_000L);
+        return new Alert(false, "La puerta sigue abierta", "Desde hace " + minutes(min) + " · te lo recuerdo cada 5 min");
+    }
+
+    static String duration(long ms) {
+        long min = ms / 60_000L;
+        return min < 1 ? "menos de un minuto" : minutes(min);
+    }
+
+    private static String minutes(long min) {
+        return min < 60 ? min + " min" : (min / 60) + " h" + (min % 60 == 0 ? "" : " " + (min % 60) + " min");
+    }
+}
