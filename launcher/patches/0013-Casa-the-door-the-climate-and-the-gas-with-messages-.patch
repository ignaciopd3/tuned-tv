diff --git a/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/LogicTest.java b/addons/casa/app/src/test/java/io/github/ignaciopd3/casa/LogicTest.java
new file mode 100644
index 0000000..a6a6e7e
