@@ -0,0 +1,143 @@
+package io.github.ignaciopd3.casa;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import java.util.List;
+import org.junit.Test;
+
+/** The door's messages, MQTT reports and the readings' wording: no Android, no network. */
+public class LogicTest {
+    private static final long MIN = 60_000L;
+
+    @Test
+    public void theDoorSaysOpenRemindsEveryFiveMinutesAndSaysHowLongWhenClosed() {
+        DoorAlerts d = new DoorAlerts();
+        d.init(false, 0);
+        DoorAlerts.Alert open = d.onDoor(true, 1000);
+        assertEquals("Puerta abierta", open.title);
+        assertNull(d.onTick(1000 + 4 * MIN));
+        DoorAlerts.Alert r1 = d.onTick(1000 + 5 * MIN);
+        assertEquals("La puerta sigue abierta", r1.title);
+        assertEquals("Desde hace 5 min · te lo recuerdo cada 5 min", r1.sub);
+        assertNull(d.onTick(1000 + 6 * MIN));
+        assertEquals("Desde hace 10 min · te lo recuerdo cada 5 min", d.onTick(1000 + 10 * MIN).sub);
+        DoorAlerts.Alert closed = d.onDoor(false, 1000 + 12 * MIN);
+        assertEquals("Puerta cerrada", closed.title);
+        assertEquals("Estuvo abierta 12 min", closed.sub);
+        assertNull(d.onTick(1000 + 20 * MIN));
+    }
+
+    @Test
+    public void repeatedReportsAndTheFirstReadingSayNothing() {
+        DoorAlerts d = new DoorAlerts();
+        assertNull(d.onDoor(true, 0));     // first reading: just learns the state
+        assertNull(d.onDoor(true, 5));     // the same state again
+        assertEquals("Estuvo abierta menos de un minuto", d.onDoor(false, 30_000).sub);
+    }
+
+    @Test
+    public void turningTheTvOnWithTheDoorOpenReminds() {
+        DoorAlerts d = new DoorAlerts();
+        d.init(true, 0);
+        assertEquals("Desde hace 1 h 5 min · te lo recuerdo cada 5 min", d.onScreenOn(65 * MIN).sub);
+        d.onDoor(false, 70 * MIN);
+        assertNull(d.onScreenOn(71 * MIN));
+        assertEquals("Estuvo abierta 1 h 10 min", new DoorAlerts() {{ init(true, 0); }}.onDoor(false, 70 * MIN).sub);
+    }
+
+    @Test
+    public void nextTickIsTheNextReminder() {
+        DoorAlerts d = new DoorAlerts();
+        d.init(false, 0);
+        assertEquals(-1, d.nextTickAt());
+        d.onDoor(true, 1000);
+        assertEquals(1000 + 5 * MIN, d.nextTickAt());
+    }
+
+    @Test
+    public void mqttReportsByDataPointOrByCode() throws Exception {
+        List<Reports.Change> c = Reports.parse("{\"protocol\":4,\"data\":{\"devId\":\"d1\",\"status\":[{\"dpId\":1,\"t\":1,\"value\":true},{\"code\":\"va_humidity\",\"value\":66}]}}");
+        assertEquals(2, c.size());
+        assertEquals("d1", c.get(0).devId);
+        assertEquals("1", c.get(0).dp);
+        assertEquals(Boolean.TRUE, c.get(0).value);
+        assertEquals("va_humidity", c.get(1).dp);
+        assertEquals(0, Reports.parse("{\"protocol\":20,\"data\":{}}").size());
+        assertEquals(0, Reports.parse("not json").size());
+    }
+
+    @Test
+    public void rolesTranslateDataPointsAndCodes() {
+        assertEquals(Roles.Field.ON, Roles.field(Devices.LUZ, "1"));
+        assertEquals(Roles.Field.ON, Roles.field(Devices.CALEFACTOR, "switch_1"));
+        assertEquals(Roles.Field.TEMPERATURE, Roles.field(Roles.CLIMA, "1"));
+        assertEquals(Roles.Field.HUMIDITY, Roles.field(Roles.CLIMA, "humidity_value"));
+        assertEquals(Roles.Field.HUMIDITY, Roles.field(Roles.CLIMA, "va_humidity"));
+        assertEquals(Roles.Field.DOOR_OPEN, Roles.field(Roles.PUERTA, "doorcontact_state"));
+        assertEquals(Roles.Field.GAS, Roles.field(Roles.GAS, "2"));
+        assertNull(Roles.field(Roles.GAS, "5"));
+    }
+
+    @Test
+    public void readingsAreWrittenTheSpanishWay() {
+        assertEquals("20,3°", State.temperature(203));
+        assertEquals("-1,5°", State.temperature(-15));
+        assertEquals("—", State.temperature(null));
+        assertEquals("66 %", State.humidity(66));
+        assertEquals("—", State.humidity(null));
+    }
+
+    /** A 3.4 frame as the sensor sends it: return code in clear, then the ECB payload, then the HMAC. */
+    private static byte[] device34(int cmd, byte[] raw, byte[] key) throws Exception {
+        javax.crypto.Cipher c = javax.crypto.Cipher.getInstance("AES/ECB/PKCS5Padding");
+        c.init(javax.crypto.Cipher.ENCRYPT_MODE, new javax.crypto.spec.SecretKeySpec(key, "AES"));
+        byte[] enc = c.doFinal(raw);
+        java.nio.ByteBuffer b = java.nio.ByteBuffer.allocate(16 + 4 + enc.length + 36);
+        b.putInt(0x000055AA).putInt(9).putInt(cmd).putInt(4 + enc.length + 36).putInt(0).put(enc);
+        b.put(Frames.hmac(key, java.util.Arrays.copyOf(b.array(), 20 + enc.length))).putInt(0x0000AA55);
+        return b.array();
+    }
+
+    @Test
+    public void theGasSensorHandshakeGivesTheSessionKey() throws Exception {
+        byte[] key = "0123456789abcdef".getBytes(java.nio.charset.StandardCharsets.US_ASCII);
+        byte[] local = new byte[16], remote = new byte[16];
+        java.util.Arrays.fill(local, (byte) 1);
+        java.util.Arrays.fill(remote, (byte) 2);
+        java.util.List<byte[]> sent = new java.util.ArrayList<>();
+        byte[] offer = device34(Frames.SESS_KEY_NEG_RESP, concat(remote, Frames.hmac(key, local)), key);
+        TuyaLocal.Transport sensor = new TuyaLocal.Transport() {
+            boolean answered;
+            public void write(byte[] f) { sent.add(f); }
+            public byte[] readFrame() throws java.io.IOException { if (answered) throw new java.io.IOException("timeout"); answered = true; return offer; }
+            public void close() { }
+        };
+        byte[] session = GasWatch.negotiate34(sensor, key, n -> local.clone());
+        assertEquals(java.util.Arrays.toString(Frames.sessionKey34(key, local, remote)), java.util.Arrays.toString(session));
+        assertEquals(2, sent.size());
+        Frames.Message finish = Frames.decode34(concatRetcode(sent.get(1)), key);
+        assertEquals(java.util.Arrays.toString(Frames.hmac(key, remote)), java.util.Arrays.toString(finish.payload));
+        assertEquals("alarm", GasWatch.gasStatus("{\"protocol\":4,\"data\":{\"dps\":{\"2\":\"alarm\"}}}".getBytes()));
+        assertEquals("normal", GasWatch.gasStatus("{\"dps\":{\"1\":\"others\",\"2\":\"normal\",\"3\":180}}".getBytes()));
+        assertNull(GasWatch.gasStatus("{\"dps\":{\"5\":0}}".getBytes()));
+    }
+
+    /** Client frames carry no return code; give one so the device-side decoder reads them (HMAC recomputed). */
+    private static byte[] concatRetcode(byte[] f) throws Exception {
+        java.nio.ByteBuffer in = java.nio.ByteBuffer.wrap(f);
+        int len = in.getInt(12);
+        byte[] enc = java.util.Arrays.copyOfRange(f, 16, 16 + len - 36);
+        byte[] key = "0123456789abcdef".getBytes(java.nio.charset.StandardCharsets.US_ASCII);
+        java.nio.ByteBuffer b = java.nio.ByteBuffer.allocate(16 + 4 + enc.length + 36);
+        b.putInt(0x000055AA).putInt(in.getInt(4)).putInt(in.getInt(8)).putInt(4 + enc.length + 36).putInt(0).put(enc);
+        b.put(Frames.hmac(key, java.util.Arrays.copyOf(b.array(), 20 + enc.length))).putInt(0x0000AA55);
+        return b.array();
+    }
+
+    private static byte[] concat(byte[] a, byte[] b) {
+        byte[] out = java.util.Arrays.copyOf(a, a.length + b.length);
+        System.arraycopy(b, 0, out, a.length, b.length);
+        return out;
+    }
+}
