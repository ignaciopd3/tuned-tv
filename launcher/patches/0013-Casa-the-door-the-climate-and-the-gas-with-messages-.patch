+package io.github.ignaciopd3.casa;
+
+/** What Casa knows right now, as the launcher's row shows it. Unknown readings show as "—". */
+final class State {
+    Boolean luz, calefactor, doorOpen;
+    Integer temperatureTenths, humidity;
+    String gas;
+    boolean cloudConnected;
+
+    static String temperature(Integer tenths) {
+        if (tenths == null) return "—";
+        int abs = Math.abs(tenths);
+        return (tenths < 0 ? "-" : "") + (abs / 10) + "," + (abs % 10) + "°";
+    }
+
+    static String humidity(Integer percent) {
+        return percent == null ? "—" : percent + " %";
+    }
+}
