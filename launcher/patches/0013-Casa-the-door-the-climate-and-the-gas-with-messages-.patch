@@ -0,0 +1,202 @@
+package io.github.ignaciopd3.casa;
+
+import android.animation.ObjectAnimator;
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.PixelFormat;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.media.AudioManager;
+import android.media.ToneGenerator;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+/**
+ * The messages over whatever is on screen, in the top-centre capsule the owner chose: the door ones are small, a
+ * little see-through and never take the remote; the gas alarm is large and red over a darkened screen, beeps, and
+ * stays until OK (it takes the remote focus for that). Needs "display over other apps" (granted from the PC); without
+ * it a plain toast says the same.
+ */
+final class Overlay {
+    static final int AMBER = 0xFFFFB340, GREEN = 0xFF30D158, RED = 0xFFFF453A, GREY = 0xFF98A1B0;
+    private static final long BEEP_EVERY_MS = 3000;
+
+    private final Context ctx;
+    private final WindowManager wm;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final float dp;
+    private View small;
+    private final Runnable hideSmall = this::removeSmall;
+    private FrameLayout gas;
+    private TextView gasSub;
+    private ToneGenerator tone;
+    private final Runnable beep = new Runnable() {
+        @Override
+        public void run() {
+            if (tone != null) tone.startTone(ToneGenerator.TONE_CDMA_ALERT_CALL_GUARD, 600);
+            main.postDelayed(this, BEEP_EVERY_MS);
+        }
+    };
+
+    Overlay(Context ctx) {
+        this.ctx = ctx;
+        this.wm = ctx.getSystemService(WindowManager.class);
+        this.dp = ctx.getResources().getDisplayMetrics().density;
+    }
+
+    /** A door or connection message: small, top centre, gone after a few seconds; replaces the previous one. */
+    void showSmall(int color, int icon, String title, String sub, long forMs) {
+        if (!Settings.canDrawOverlays(ctx)) {
+            Toast.makeText(ctx, title + " · " + sub, Toast.LENGTH_LONG).show();
+            return;
+        }
+        removeSmall();
+        small = capsule(color, icon, title, sub, false);
+        small.setAlpha(0.94f);
+        WindowManager.LayoutParams lp = params(false);
+        lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
+        lp.y = px(16);
+        wm.addView(small, lp);
+        main.postDelayed(hideSmall, forMs);
+    }
+
+    /** The gas alarm: darkened screen, large red capsule that pulses, a beep every 3 s, until OK. */
+    void showGas() {
+        if (gas != null) return;
+        if (!Settings.canDrawOverlays(ctx)) {
+            Toast.makeText(ctx, "Alarma de gas: el sensor de gas se ha activado", Toast.LENGTH_LONG).show();
+            return;
+        }
+        gas = new FrameLayout(ctx);
+        gas.setBackgroundColor(0x73000000);
+        LinearLayout box = capsule(RED, R.drawable.ic_flame, "Alarma de gas", "El sensor de gas se ha activado · pulsa OK para cerrar", true);
+        gasSub = (TextView) box.findViewWithTag("sub");
+        FrameLayout.LayoutParams flp = new FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT,
+                FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.CENTER_HORIZONTAL);
+        flp.topMargin = px(20);
+        gas.addView(box, flp);
+        ObjectAnimator pulse = ObjectAnimator.ofFloat(box, View.ALPHA, 1f, 0.7f);
+        pulse.setDuration(800);
+        pulse.setRepeatMode(ValueAnimator.REVERSE);
+        pulse.setRepeatCount(ValueAnimator.INFINITE);
+        pulse.start();
+        gas.setFocusable(true);
+        gas.setFocusableInTouchMode(true);
+        gas.setOnKeyListener((v, code, ev) -> {
+            boolean ok = code == KeyEvent.KEYCODE_DPAD_CENTER || code == KeyEvent.KEYCODE_ENTER
+                    || code == KeyEvent.KEYCODE_NUMPAD_ENTER || code == KeyEvent.KEYCODE_BACK;
+            if (ok && ev.getAction() == KeyEvent.ACTION_UP) dismissGas();
+            return ok;
+        });
+        WindowManager.LayoutParams lp = params(true);
+        lp.width = WindowManager.LayoutParams.MATCH_PARENT;
+        lp.height = WindowManager.LayoutParams.MATCH_PARENT;
+        wm.addView(gas, lp);
+        gas.requestFocus();
+        try {
+            tone = new ToneGenerator(AudioManager.STREAM_MUSIC, ToneGenerator.MAX_VOLUME);
+            main.post(beep);
+        } catch (RuntimeException noAudio) {
+            tone = null;   // no tone on this set: the screen still says it
+        }
+    }
+
+    /** The sensor is back to normal: stop the beep, keep the message until OK. */
+    void gasCleared() {
+        stopBeep();
+        if (gasSub != null) gasSub.setText("La alarma se ha parado · pulsa OK para cerrar");
+    }
+
+    void dismissGas() {
+        stopBeep();
+        if (gas != null) {
+            wm.removeView(gas);
+            gas = null;
+            gasSub = null;
+        }
+    }
+
+    private void stopBeep() {
+        main.removeCallbacks(beep);
+        if (tone != null) {
+            tone.release();
+            tone = null;
+        }
+    }
+
+    private void removeSmall() {
+        main.removeCallbacks(hideSmall);
+        if (small != null) {
+            wm.removeView(small);
+            small = null;
+        }
+    }
+
+    private WindowManager.LayoutParams params(boolean focusable) {
+        int flags = WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN;
+        if (!focusable) flags |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE;
+        return new WindowManager.LayoutParams(WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT,
+                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, flags, PixelFormat.TRANSLUCENT);
+    }
+
+    /** Dark glass capsule: a coloured disc with the icon, then the title over a quieter line. */
+    private LinearLayout capsule(int color, int icon, String title, String sub, boolean big) {
+        LinearLayout row = new LinearLayout(ctx);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        int h = px(big ? 60 : 42);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(big ? 0xE6140606 : 0xD1080A10);
+        bg.setCornerRadius(h / 2f);
+        bg.setStroke(Math.max(1, px(big ? 2 : 1)), big ? color : (color & 0x00FFFFFF) | 0x99000000);
+        row.setBackground(bg);
+        row.setMinimumHeight(h);
+        row.setPadding(px(big ? 12 : 8), px(6), px(big ? 26 : 18), px(6));
+
+        FrameLayout disc = new FrameLayout(ctx);
+        GradientDrawable circle = new GradientDrawable();
+        circle.setShape(GradientDrawable.OVAL);
+        circle.setColor(color);
+        disc.setBackground(circle);
+        ImageView img = new ImageView(ctx);
+        img.setImageResource(icon);
+        img.setColorFilter(0xFF1B1205);
+        int d = px(big ? 40 : 28);
+        disc.addView(img, new FrameLayout.LayoutParams(d * 6 / 10, d * 6 / 10, Gravity.CENTER));
+        LinearLayout.LayoutParams dlp = new LinearLayout.LayoutParams(d, d);
+        dlp.setMarginEnd(px(big ? 14 : 10));
+        row.addView(disc, dlp);
+
+        LinearLayout texts = new LinearLayout(ctx);
+        texts.setOrientation(LinearLayout.VERTICAL);
+        TextView t = new TextView(ctx);
+        t.setText(title);
+        t.setTextColor(Color.WHITE);
+        t.setTextSize(big ? 22 : 15);
+        t.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+        TextView s = new TextView(ctx);
+        s.setText(sub);
+        s.setTag("sub");
+        s.setTextColor(0xBFFFFFFF);
+        s.setTextSize(big ? 14 : 11);
+        texts.addView(t);
+        texts.addView(s);
+        row.addView(texts);
+        return row;
+    }
+
+    private int px(float dps) {
+        return Math.round(dps * dp);
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/Reports.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/Reports.java
new file mode 100644
