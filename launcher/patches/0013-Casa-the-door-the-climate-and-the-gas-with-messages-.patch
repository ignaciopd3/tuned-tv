--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/Reports.java
@@ -0,0 +1,44 @@
+package io.github.ignaciopd3.casa;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Tuya's MQTT device reports (protocol 4): each changed data point, by number (devices that also speak LAN) or code. */
+final class Reports {
+    static final class Change {
+        final String devId, dp;
+        final Object value;
+
+        Change(String devId, String dp, Object value) {
+            this.devId = devId;
+            this.dp = dp;
+            this.value = value;
+        }
+    }
+
+    private Reports() {
+    }
+
+    static List<Change> parse(String json) {
+        List<Change> out = new ArrayList<>();
+        try {
+            JSONObject o = new JSONObject(json);
+            if (o.optInt("protocol") != 4) return out;
+            JSONObject data = o.getJSONObject("data");
+            String devId = data.getString("devId");
+            JSONArray status = data.optJSONArray("status");
+            for (int i = 0; status != null && i < status.length(); i++) {
+                JSONObject s = status.getJSONObject(i);
+                if (!s.has("value")) continue;
+                if (s.has("dpId")) out.add(new Change(devId, String.valueOf(s.get("dpId")), s.get("value")));
+                else if (s.has("code")) out.add(new Change(devId, s.getString("code"), s.get("value")));
+            }
+        } catch (JSONException e) {
+            // Not a report Casa understands: nothing changes.
+        }
+        return out;
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/Roles.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/Roles.java
