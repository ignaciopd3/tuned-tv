     /** Adds the row when Casa is installed and answers; null otherwise, and the top bar stays as it was. */
     static CasaRow attach(MainActivity activity, String pkg, LinearLayout bar, int leftBlockId) {
         if (pkg.isEmpty() || activity.getPackageManager().resolveContentProvider(pkg + ".now", 0) == null) return null;
+        keepCasaUp(activity, pkg);
         CasaRow row = new CasaRow(activity, pkg);
         row.build(bar, leftBlockId);
         return row;
     }
 
+    private static boolean bound;
+
+    /**
+     * Binds Casa's service for as long as the launcher's process lives, which keeps its alerts running over any channel.
+     * TCL refuses to let Casa make itself a foreground service from the background, but a binding from Home is allowed.
+     */
+    private static void keepCasaUp(MainActivity activity, String pkg) {
+        if (bound) return;
+        try {
+            bound = activity.getApplicationContext().bindService(
+                    new Intent().setComponent(new ComponentName(pkg, pkg + ".CasaService")), new ServiceConnection() {
+                        @Override
+                        public void onServiceConnected(ComponentName name, IBinder service) {
+                        }
+
+                        @Override
+                        public void onServiceDisconnected(ComponentName name) {
+                            // Casa crashed or was updated: Android rebinds by itself while the binding stands.
+                        }
+                    }, Context.BIND_AUTO_CREATE | Context.BIND_IMPORTANT);
+        } catch (RuntimeException refused) {
+            // An older Casa without the service, or without our permission: the row still reads what it can.
+        }
+    }
+
     private void build(LinearLayout bar, int leftBlockId) {
