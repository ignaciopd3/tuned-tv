+    private Drawable libraryDot() {
+        GradientDrawable dot = new GradientDrawable();
+        dot.setShape(GradientDrawable.OVAL);
+        dot.setColor(0xFFFF5A4F);
+        dot.setStroke(Math.round(2 * density), Color.WHITE);
+        LayerDrawable layer = new LayerDrawable(new Drawable[] {dot});
+        int size = Math.round(12 * density);
+        layer.setLayerSize(0, size, size);
+        layer.setLayerGravity(0, Gravity.TOP | Gravity.RIGHT);
+        return layer;
     }
 
