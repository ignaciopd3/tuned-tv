-    /** adb_warning_app: watch the two ADB switches while Home is on screen. */
+    /**
+     * The whole line when it fits, else only its first " · " part (the sky, or tomorrow) rather than a word cut by
+     * an ellipsis: "Lluvia débil · Sensación 14°" did not fit beside a long date.
+     */
+    private static void fitLine(TextView view, String text) {
+        view.setText(text);
+        int cut = text.indexOf(" · ");
+        if (cut < 0) return;
+        view.getViewTreeObserver().addOnPreDrawListener(new ViewTreeObserver.OnPreDrawListener() {
+            @Override
+            public boolean onPreDraw() {
+                view.getViewTreeObserver().removeOnPreDrawListener(this);
+                Layout layout = view.getLayout();
+                if (layout == null || layout.getEllipsisCount(0) == 0 || !text.contentEquals(view.getText())) return true;
+                view.setText(text.substring(0, cut));
+                return false;
+            }
+        });
+    }
