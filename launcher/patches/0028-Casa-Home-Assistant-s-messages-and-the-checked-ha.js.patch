+        assertEquals("on", states.get("light.salon").state);
+        assertEquals("Salón", states.get("light.salon").attributes.getString("friendly_name"));
+
+        List<Ha.Change> changed = Ha.apply(states, new JSONObject("{\"c\":{\"light.salon\":"
+                + "{\"+\":{\"s\":\"off\",\"lc\":2.0},\"-\":{\"a\":[\"brightness\"]}}}}"));
+        assertEquals(1, changed.size());
+        assertFalse(changed.get(0).initial);
+        assertTrue(changed.get(0).stateChanged);
+        assertEquals("off", states.get("light.salon").state);
