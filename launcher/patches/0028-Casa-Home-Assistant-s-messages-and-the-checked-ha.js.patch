+package io.github.ignaciopd3.casa;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.junit.Test;
+
+public class HaConfigTest {
+    static final String SAMPLE = "{\"url\":\"http://192.168.1.10:8123\",\"token\":\"eyJ.abc.def\","
+            + "\"roles\":{\"luz\":\"light.salon\",\"calefactor\":\"switch.calefactor\",\"temperatura\":\"sensor.salon_temperatura\","
+            + "\"humedad\":\"sensor.salon_humedad\",\"puerta\":\"binary_sensor.puerta_entrada\",\"gas\":\"binary_sensor.gas\"},"
+            + "\"timbres\":[{\"nombre\":\"Puerta\",\"llamada\":\"event.puerta_ding\",\"movimiento\":\"event.puerta_motion\","
+            + "\"camara\":\"camera.puerta_live_view\",\"abrir\":[\"lock.puerta\"]},"
+            + "{\"nombre\":\"Portal\",\"llamada\":\"event.portal_ding\",\"abrir\":[\"button.portal_open_door\"]}],"
+            + "\"aviso_movimiento\":\"aviso\",\"abrir_tras_llamada_s\":180,\"pausar\":true}";
+
+    @Test
+    public void theDesignsExampleIsAccepted() throws Exception {
+        HaConfig c = HaConfig.parse(SAMPLE);
+        assertEquals("ws://192.168.1.10:8123/api/websocket", c.ws.toString());
+        assertEquals("eyJ.abc.def", c.token);
+        assertEquals("light.salon", c.roles.get("luz"));
+        assertEquals(2, c.doorbells.size());
+        HaConfig.Doorbell door = c.doorbells.get(0);
+        assertEquals("Puerta", door.name);
+        assertEquals("event.puerta_ding", door.ring);
+        assertEquals("event.puerta_motion", door.motion);
+        assertEquals("camera.puerta_live_view", door.camera);
+        assertEquals(1, door.open.size());
+        assertNull(c.doorbells.get(1).camera);
+        assertEquals("aviso", c.motionMode);
+        assertEquals(180, c.openWindowS);
+        assertTrue(c.pause);
+        assertEquals("luz", c.roleOf("light.salon"));
+        assertNull(c.roleOf("light.otra"));
+        assertTrue(c.entityIds().contains("event.portal_ding"));
+        assertTrue(c.entityIds().contains("lock.puerta"));   // to know whether lock.open is supported
+        assertFalse(c.entityIds().contains("camera.puerta_live_view"));   // cameras are asked for when needed
+    }
+
+    @Test
+    public void httpsBecomesWssAndDefaultsApply() throws Exception {
+        HaConfig c = HaConfig.parse("{\"url\":\"https://casa.example.org\",\"token\":\"t\",\"roles\":{\"luz\":\"light.a\"}}");
+        assertEquals("wss://casa.example.org/api/websocket", c.ws.toString());
+        assertEquals("aviso", c.motionMode);
+        assertEquals(180, c.openWindowS);
+        assertTrue(c.pause);
+        assertTrue(c.doorbells.isEmpty());
+    }
+
+    @Test
+    public void whatDoesNotFitIsRefused() throws Exception {
+        refuse(with("url", "ftp://x"));
+        refuse(with("url", "http://"));
+        refuse(with("url", "http://h:8123/lovelace"));
+        refuse(with("token", ""));
+        refuse(with("token", "a b"));
+        refuse(roles("luz", "Light.Salon"));
+        refuse(roles("luz", "sensor.t"));
+        refuse(roles("temperatura", "binary_sensor.x"));
+        refuse(roles("puerta", "sensor.x"));
+        refuse(roles("desconocido", "light.x"));
+        refuse(doorbell("llamada", "binary_sensor.ding"));
+        refuse(doorbell("camara", "image.x"));
+        refuse(doorbell("abrir", new JSONArray().put("switch.x")));
+        refuse(doorbell("abrir", new JSONArray().put("lock.a").put("lock.b").put("lock.c").put("lock.d")));
+        refuse(doorbell("movimiento", "sensor.m"));
+        refuse(doorbell("nombre", ""));
+        refuse(with("aviso_movimiento", "siempre"));
+        refuse(with("abrir_tras_llamada_s", 10));
+        refuse(with("abrir_tras_llamada_s", 900));
+        JSONObject five = new JSONObject(SAMPLE);
+        JSONArray bells = five.getJSONArray("timbres");
+        for (int i = 0; i < 3; i++) bells.put(new JSONObject().put("nombre", "T" + i).put("llamada", "event.t" + i));
+        refuse(five.toString());
+        JSONObject noBell = new JSONObject(SAMPLE);
+        noBell.getJSONArray("timbres").getJSONObject(0).remove("llamada");
+        refuse(noBell.toString());
+    }
+
+    @Test
+    public void aMotionBinarySensorIsAcceptedToo() throws Exception {
+        HaConfig.parse(doorbell("movimiento", "binary_sensor.entrada_movimiento"));
+    }
+
+    private static String with(String key, Object value) throws JSONException {
+        return new JSONObject(SAMPLE).put(key, value).toString();
+    }
+
+    private static String roles(String role, String entity) throws JSONException {
+        JSONObject o = new JSONObject(SAMPLE);
+        o.getJSONObject("roles").put(role, entity);
+        return o.toString();
+    }
+
+    private static String doorbell(String key, Object value) throws JSONException {
+        JSONObject o = new JSONObject(SAMPLE);
+        o.getJSONArray("timbres").getJSONObject(0).put(key, value);
+        return o.toString();
+    }
+
+    private static void refuse(String json) {
+        try {
+            HaConfig.parse(json);
+            fail("should be refused: " + json);
+        } catch (JSONException expected) {
+            // refused, as it should
+        }
+    }
+}
