+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/Ha.java
@@ -0,0 +1,301 @@
+package io.github.ignaciopd3.casa;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * Home Assistant's WebSocket messages, without any network: what Casa sends (auth, subscribe_entities, call_service,
+ * WebRTC) and how it reads what comes back (the compressed entity states "a"/"c"/"r", new events, WebRTC answers).
+ * Field names from Home Assistant's websocket_api and camera/webrtc.py, read on 2026-11-25.
+ */
+final class Ha {
+    /** LockEntityFeature.OPEN: the lock can unlatch, not just unlock. */
+    private static final int LOCK_OPEN = 1;
+
+    private Ha() {
+    }
+
+    // ---- outgoing ----
+
+    static String auth(String token) {
+        return json(() -> obj().put("type", "auth").put("access_token", token));
+    }
+
+    static String subscribeEntities(int id, Collection<String> entityIds) {
+        return json(() -> msg(id, "subscribe_entities").put("entity_ids", new JSONArray(entityIds)));
+    }
+
+    static String callService(int id, String domain, String service, String entityId) {
+        return json(() -> msg(id, "call_service").put("domain", domain).put("service", service)
+                .put("target", obj().put("entity_id", entityId)));
+    }
+
+    static String ping(int id) {
+        return json(() -> msg(id, "ping"));
+    }
+
+    static String unsubscribe(int id, int subscription) {
+        return json(() -> msg(id, "unsubscribe_events").put("subscription", subscription));
+    }
+
+    static String capabilities(int id, String camera) {
+        return json(() -> msg(id, "camera/capabilities").put("entity_id", camera));
+    }
+
+    static String webrtcClientConfig(int id, String camera) {
+        return json(() -> msg(id, "camera/webrtc/get_client_config").put("entity_id", camera));
+    }
+
+    static String webrtcOffer(int id, String camera, String sdp) {
+        return json(() -> msg(id, "camera/webrtc/offer").put("entity_id", camera).put("offer", sdp));
+    }
+
+    static String webrtcCandidate(int id, String camera, String session, String candidate, String sdpMid, Integer sdpMLineIndex) {
+        return json(() -> {
+            JSONObject c = obj().put("candidate", candidate);
+            if (sdpMid != null) c.put("sdpMid", sdpMid);
+            if (sdpMLineIndex != null) c.put("sdpMLineIndex", sdpMLineIndex.intValue());
+            return msg(id, "camera/webrtc/candidate").put("entity_id", camera).put("session_id", session).put("candidate", c);
+        });
+    }
+
+    /** {domain, service} that opens with this entity: a button is pressed, a lock unlatches if it can, else unlocks. */
+    static String[] openService(String entityId, boolean lockCanOpen) {
+        if (entityId.startsWith("button.")) return new String[] {"button", "press"};
+        return new String[] {"lock", lockCanOpen ? "open" : "unlock"};
+    }
+
+    static String[] toggleService() {
+        return new String[] {"homeassistant", "toggle"};
+    }
+
+    static boolean lockCanOpen(JSONObject attributes) {
+        return attributes != null && (attributes.optInt("supported_features", 0) & LOCK_OPEN) != 0;
+    }
+
+    // ---- entity states ----
+
+    /** One entity as Casa keeps it: its state and its attributes, updated in place by apply(). */
+    static final class Entity {
+        String state;
+        JSONObject attributes = new JSONObject();
+    }
+
+    /** What one subscription event did to one entity. */
+    static final class Change {
+        final String id;
+        final boolean initial, stateChanged, removed;
+
+        Change(String id, boolean initial, boolean stateChanged, boolean removed) {
+            this.id = id;
+            this.initial = initial;
+            this.stateChanged = stateChanged;
+            this.removed = removed;
+        }
+    }
+
+    /** Applies a subscribe_entities event ("a" initial states, "c" changes, "r" removals) to the states. */
+    static List<Change> apply(Map<String, Entity> states, JSONObject event) throws JSONException {
+        List<Change> out = new ArrayList<>();
+        JSONObject added = event.optJSONObject("a");
+        if (added != null) {
+            for (Iterator<String> it = added.keys(); it.hasNext(); ) {
+                String id = it.next();
+                JSONObject s = added.getJSONObject(id);
+                Entity e = new Entity();
+                e.state = s.optString("s", null);
+                JSONObject a = s.optJSONObject("a");
+                if (a != null) e.attributes = a;
+                states.put(id, e);
+                out.add(new Change(id, true, true, false));
+            }
+        }
+        JSONObject changed = event.optJSONObject("c");
+        if (changed != null) {
+            for (Iterator<String> it = changed.keys(); it.hasNext(); ) {
+                String id = it.next();
+                JSONObject diff = changed.getJSONObject(id);
+                Entity e = states.get(id);
+                if (e == null) {
+                    e = new Entity();
+                    states.put(id, e);
+                }
+                boolean stateChanged = false;
+                JSONObject plus = diff.optJSONObject("+");
+                if (plus != null) {
+                    if (plus.has("s")) {
+                        e.state = plus.getString("s");
+                        stateChanged = true;
+                    }
+                    JSONObject a = plus.optJSONObject("a");
+                    if (a != null) {
+                        for (Iterator<String> k = a.keys(); k.hasNext(); ) {
+                            String key = k.next();
+                            e.attributes.put(key, a.get(key));
+                        }
+                    }
+                }
+                JSONObject minus = diff.optJSONObject("-");
+                JSONArray gone = minus == null ? null : minus.optJSONArray("a");
+                if (gone != null) for (int i = 0; i < gone.length(); i++) e.attributes.remove(gone.getString(i));
+                out.add(new Change(id, false, stateChanged, false));
+            }
+        }
+        JSONArray removed = event.optJSONArray("r");
+        if (removed != null) {
+            for (int i = 0; i < removed.length(); i++) {
+                String id = removed.getString(i);
+                states.remove(id);
+                out.add(new Change(id, false, false, true));
+            }
+        }
+        return out;
+    }
+
+    /**
+     * The type of a new event ("ring", "motion"…) when this change is one, else null. An event entity's state is the
+     * time of its last event: the initial state only records that time, and coming back from "unavailable" to the same
+     * time is no new event. lastEvent keeps the last time seen per entity.
+     */
+    static String newEvent(Change c, Entity e, Map<String, String> lastEvent) {
+        if (e == null || c.removed || !c.stateChanged || !looksLikeTime(e.state)) return null;
+        String before = lastEvent.put(c.id, e.state);
+        if (c.initial || e.state.equals(before)) return null;
+        return e.attributes.optString("event_type", null);
+    }
+
+    private static boolean looksLikeTime(String s) {
+        return s != null && s.length() >= 19 && Character.isDigit(s.charAt(0)) && s.charAt(10) == 'T';
+    }
+
+    static Boolean onOff(String state) {
+        if ("on".equals(state)) return Boolean.TRUE;
+        if ("off".equals(state)) return Boolean.FALSE;
+        return null;
+    }
+
+    /** A temperature in tenths of a degree, as Casa's row keeps it; null when the sensor has no number. */
+    static Integer tenths(String state) {
+        Double v = number(state);
+        return v == null ? null : (int) Math.round(v * 10);
+    }
+
+    static Integer whole(String state) {
+        Double v = number(state);
+        return v == null ? null : (int) Math.round(v);
+    }
+
+    private static Double number(String s) {
+        try {
+            return s == null ? null : Double.valueOf(s.trim());
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    // ---- WebRTC ----
+
+    static boolean supportsWebRtc(JSONObject capabilities) {
+        JSONArray types = capabilities.optJSONArray("frontend_stream_types");
+        if (types == null) return false;
+        for (int i = 0; i < types.length(); i++) if ("web_rtc".equals(types.optString(i))) return true;
+        return false;
+    }
+
+    /** One message of a WebRTC session as Home Assistant sends it on the offer's subscription. */
+    static final class Rtc {
+        enum Kind { SESSION, ANSWER, CANDIDATE, ERROR, OTHER }
+
+        Kind kind = Kind.OTHER;
+        String session, sdp, candidate, sdpMid, code, message;
+        int sdpMLineIndex = -1;
+    }
+
+    static Rtc rtc(JSONObject event) {
+        Rtc r = new Rtc();
+        switch (event.optString("type")) {
+            case "session":
+                r.kind = Rtc.Kind.SESSION;
+                r.session = event.optString("session_id", null);
+                break;
+            case "answer":
+                r.kind = Rtc.Kind.ANSWER;
+                r.sdp = event.optString("answer", null);
+                break;
+            case "candidate":
+                r.kind = Rtc.Kind.CANDIDATE;
+                JSONObject c = event.optJSONObject("candidate");
+                if (c != null) {
+                    r.candidate = c.optString("candidate", "");
+                    r.sdpMid = c.has("sdpMid") && !c.isNull("sdpMid") ? c.optString("sdpMid") : null;
+                    r.sdpMLineIndex = c.optInt("sdpMLineIndex", -1);
+                }
+                break;
+            case "error":
+                r.kind = Rtc.Kind.ERROR;
+                r.code = event.optString("code", null);
+                r.message = event.optString("message", null);
+                break;
+            default:
+                break;
+        }
+        return r;
+    }
+
+    /** An ICE server from camera/webrtc/get_client_config. */
+    static final class Ice {
+        final List<String> urls = new ArrayList<>();
+        String username, credential;
+    }
+
+    static List<Ice> iceServers(JSONObject result) {
+        List<Ice> out = new ArrayList<>();
+        JSONObject conf = result.optJSONObject("configuration");
+        JSONArray servers = conf == null ? null : conf.optJSONArray("iceServers");
+        if (servers == null) return out;
+        for (int i = 0; i < servers.length(); i++) {
+            JSONObject s = servers.optJSONObject(i);
+            if (s == null) continue;
+            Ice ice = new Ice();
+            JSONArray many = s.optJSONArray("urls");
+            if (many != null) {
+                for (int j = 0; j < many.length(); j++) ice.urls.add(many.optString(j));
+            } else if (s.has("urls")) {
+                ice.urls.add(s.optString("urls"));
+            }
+            ice.username = s.optString("username", null);
+            ice.credential = s.optString("credential", null);
+            if (!ice.urls.isEmpty()) out.add(ice);
+        }
+        return out;
+    }
+
+    // ---- helpers ----
+
+    private static JSONObject obj() {
+        return new JSONObject();
+    }
+
+    private static JSONObject msg(int id, String type) throws JSONException {
+        return new JSONObject().put("id", id).put("type", type);
+    }
+
+    private interface Build {
+        JSONObject run() throws JSONException;
+    }
+
+    /** Android's org.json declares JSONException on put, which never happens with these keys and values. */
+    private static String json(Build b) {
+        try {
+            return b.run().toString();
+        } catch (JSONException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
