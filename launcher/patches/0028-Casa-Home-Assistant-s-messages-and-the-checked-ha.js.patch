+                + "\"light.salon\":{\"s\":\"on\",\"a\":{\"friendly_name\":\"Salón\",\"brightness\":200},\"lc\":1.0},"
+                + "\"sensor.t\":{\"s\":\"21.46\",\"a\":{\"unit_of_measurement\":\"°C\"}}}}"));
