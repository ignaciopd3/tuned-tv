+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/HaConfig.java
@@ -0,0 +1,160 @@
+package io.github.ignaciopd3.casa;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * Casa's Home Assistant configuration (ha.json from tv-opt's `run.py casa`), checked before anything uses it: the
+ * address, the token, one entity per role and the doorbells. What does not fit is refused as a whole, so a typo never
+ * leaves Casa half set up.
+ */
+final class HaConfig {
+    static final String LUZ = "luz", CALEFACTOR = "calefactor", TEMPERATURA = "temperatura", HUMEDAD = "humedad",
+            PUERTA = "puerta", GAS = "gas";
+    static final String MOTION_CAPSULE = "aviso", MOTION_VIDEO = "video", MOTION_OFF = "no";
+    static final int MAX_DOORBELLS = 4, MAX_OPENERS = 3;
+    private static final Pattern ENTITY = Pattern.compile("[a-z_]+\\.[a-z0-9_]+");
+    private static final Pattern TOKEN = Pattern.compile("[\\x21-\\x7e]{1,1024}");
+    private static final Map<String, Set<String>> ROLE_DOMAINS = new LinkedHashMap<>();
+
+    static {
+        Set<String> switches = new HashSet<>(Arrays.asList("light", "switch", "fan", "input_boolean"));
+        ROLE_DOMAINS.put(LUZ, switches);
+        ROLE_DOMAINS.put(CALEFACTOR, switches);
+        ROLE_DOMAINS.put(TEMPERATURA, Collections.singleton("sensor"));
+        ROLE_DOMAINS.put(HUMEDAD, Collections.singleton("sensor"));
+        ROLE_DOMAINS.put(PUERTA, Collections.singleton("binary_sensor"));
+        ROLE_DOMAINS.put(GAS, Collections.singleton("binary_sensor"));
+    }
+
+    static final class Doorbell {
+        final String name, ring, motion, camera;
+        final List<String> open;
+
+        Doorbell(String name, String ring, String motion, String camera, List<String> open) {
+            this.name = name;
+            this.ring = ring;
+            this.motion = motion;
+            this.camera = camera;
+            this.open = Collections.unmodifiableList(open);
+        }
+    }
+
+    final URI ws;
+    final String token, motionMode;
+    final Map<String, String> roles;
+    final List<Doorbell> doorbells;
+    final int openWindowS;
+    final boolean pause;
+
+    private HaConfig(URI ws, String token, Map<String, String> roles, List<Doorbell> doorbells, String motionMode,
+                     int openWindowS, boolean pause) {
+        this.ws = ws;
+        this.token = token;
+        this.roles = Collections.unmodifiableMap(roles);
+        this.doorbells = Collections.unmodifiableList(doorbells);
+        this.motionMode = motionMode;
+        this.openWindowS = openWindowS;
+        this.pause = pause;
+    }
+
+    static HaConfig parse(String json) throws JSONException {
+        JSONObject o = new JSONObject(json);
+        URI ws = websocketFor(o.getString("url"));
+        String token = o.getString("token");
+        if (!TOKEN.matcher(token).matches()) throw new JSONException("invalid token");
+
+        Map<String, String> roles = new LinkedHashMap<>();
+        JSONObject r = o.optJSONObject("roles");
+        if (r != null) {
+            for (Iterator<String> it = r.keys(); it.hasNext(); ) {
+                String role = it.next();
+                Set<String> domains = ROLE_DOMAINS.get(role);
+                if (domains == null) throw new JSONException("unknown role " + role);
+                roles.put(role, entity(r.getString(role), domains));
+            }
+        }
+
+        List<Doorbell> doorbells = new ArrayList<>();
+        JSONArray bells = o.optJSONArray("timbres");
+        if (bells != null) {
+            if (bells.length() > MAX_DOORBELLS) throw new JSONException("too many doorbells");
+            for (int i = 0; i < bells.length(); i++) doorbells.add(doorbell(bells.getJSONObject(i)));
+        }
+
+        String motionMode = o.optString("aviso_movimiento", MOTION_CAPSULE);
+        if (!Arrays.asList(MOTION_CAPSULE, MOTION_VIDEO, MOTION_OFF).contains(motionMode)) throw new JSONException("invalid aviso_movimiento");
+        int window = o.optInt("abrir_tras_llamada_s", 180);
+        if (window < 30 || window > 600) throw new JSONException("abrir_tras_llamada_s out of 30-600");
+        if (roles.isEmpty() && doorbells.isEmpty()) throw new JSONException("nothing to watch");
+        return new HaConfig(ws, token, roles, doorbells, motionMode, window, o.optBoolean("pausar", true));
+    }
+
+    private static Doorbell doorbell(JSONObject b) throws JSONException {
+        String name = b.getString("nombre").trim();
+        if (name.isEmpty() || name.length() > 40) throw new JSONException("invalid doorbell name");
+        String ring = entity(b.getString("llamada"), Collections.singleton("event"));
+        String motion = b.has("movimiento") ? entity(b.getString("movimiento"), new HashSet<>(Arrays.asList("event", "binary_sensor"))) : null;
+        String camera = b.has("camara") ? entity(b.getString("camara"), Collections.singleton("camera")) : null;
+        List<String> open = new ArrayList<>();
+        JSONArray a = b.optJSONArray("abrir");
+        if (a != null) {
+            if (a.length() > MAX_OPENERS) throw new JSONException("too many openers");
+            Set<String> openers = new HashSet<>(Arrays.asList("button", "lock"));
+            for (int i = 0; i < a.length(); i++) open.add(entity(a.getString(i), openers));
+        }
+        return new Doorbell(name, ring, motion, camera, open);
+    }
+
+    private static String entity(String id, Set<String> domains) throws JSONException {
+        if (!ENTITY.matcher(id).matches()) throw new JSONException("invalid entity id " + id);
+        if (!domains.contains(id.substring(0, id.indexOf('.')))) throw new JSONException("wrong domain for " + id);
+        return id;
+    }
+
+    /** http://host:port → ws://host:port/api/websocket (https → wss). Only the server's root is accepted. */
+    static URI websocketFor(String url) throws JSONException {
+        try {
+            URI u = new URI(url.trim());
+            String scheme = u.getScheme() == null ? "" : u.getScheme().toLowerCase();
+            if (!scheme.equals("http") && !scheme.equals("https")) throw new JSONException("url must be http or https");
+            if (u.getHost() == null || u.getHost().isEmpty()) throw new JSONException("url without host");
+            String path = u.getPath() == null ? "" : u.getPath();
+            if (!path.isEmpty() && !path.equals("/")) throw new JSONException("url must be the server's root");
+            return new URI(scheme.equals("https") ? "wss" : "ws", null, u.getHost(), u.getPort(), "/api/websocket", null, null);
+        } catch (URISyntaxException e) {
+            throw new JSONException("invalid url");
+        }
+    }
+
+    /** The role of an entity, or null when it is not one of the roles. */
+    String roleOf(String entityId) {
+        for (Map.Entry<String, String> e : roles.entrySet()) if (e.getValue().equals(entityId)) return e.getKey();
+        return null;
+    }
+
+    /** Everything Casa subscribes to: the roles, each doorbell's ring and motion, and its locks (for lock.open). */
+    Set<String> entityIds() {
+        Set<String> ids = new LinkedHashSet<>(roles.values());
+        for (Doorbell d : doorbells) {
+            ids.add(d.ring);
+            if (d.motion != null) ids.add(d.motion);
+            for (String e : d.open) if (e.startsWith("lock.")) ids.add(e);
+        }
+        return ids;
+    }
+}
