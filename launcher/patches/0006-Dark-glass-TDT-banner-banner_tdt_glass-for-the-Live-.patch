Subject: [PATCH 06/23] Dark glass TDT banner (banner_tdt_glass) for the Live
 TV tile

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../main/res/drawable/banner_tdt_glass.xml    | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)
 create mode 100644 launcher/app/src/main/res/drawable/banner_tdt_glass.xml

diff --git a/launcher/app/src/main/res/drawable/banner_tdt_glass.xml b/launcher/app/src/main/res/drawable/banner_tdt_glass.xml
new file mode 100644
index 0000000..750745e
--- /dev/null
+++ b/launcher/app/src/main/res/drawable/banner_tdt_glass.xml
@@ -0,0 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Banner for a Live TV app tile (config.xml, app_banners): dark glass like the header capsules, a thin TV
+     glyph and «TDT» drawn as strokes. Translucent, so the card's tile_bg shows a little through it. The border's
+     corner radius matches the tile's (16dp on a 180dp card = 28.5 of the 320 viewport). -->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="160dp" android:height="90dp"
+    android:viewportWidth="320" android:viewportHeight="180">
+    <path android:fillColor="#CC0A0C12" android:pathData="M0,0h320v180h-320z" />
+    <path android:strokeColor="#33FFFFFF" android:strokeWidth="3" android:fillColor="#00000000"
+        android:pathData="M28.5,1.5h263a27,27 0,0 1,27 27v123a27,27 0,0 1,-27 27h-263a27,27 0,0 1,-27 -27v-123a27,27 0,0 1,27 -27z" />
+    <group android:translateX="71" android:translateY="59" android:scaleX="2.6" android:scaleY="2.6">
+        <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.9" android:strokeLineCap="round"
+            android:strokeLineJoin="round" android:fillColor="#00000000"
+            android:pathData="M5,6.5h14a2,2 0,0 1,2 2v8.5a2,2 0,0 1,-2 2h-14a2,2 0,0 1,-2 -2v-8.5a2,2 0,0 1,2 -2z" />
+        <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.9" android:strokeLineCap="round"
+            android:strokeLineJoin="round" android:fillColor="#00000000"
+            android:pathData="M8.5,2.5L12,6.5L15.5,2.5M7.5,19L6.5,21.5M16.5,19L17.5,21.5" />
+    </group>
+    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="5" android:strokeLineJoin="round"
+        android:fillColor="#00000000"
+        android:pathData="M151,75.5H175M163,75.5V107M185.5,75.5H193a14.5,14.5 0,0 1,0 29H185.5zM217,75.5H241M229,75.5V107" />
+</vector>
