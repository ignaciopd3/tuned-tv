@@ -1,6 +1,11 @@
 package com.gathin.tvhome;
 
 import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Map;
+
+import static org.junit.Assert.assertEquals;
 import static org.junit.Assert.assertFalse;
 import static org.junit.Assert.assertTrue;
 
@@ -57,4 +62,16 @@ public class HomeKeyServiceTest {
         assertTrue(HomeKeyService.stillArmed(SOON, SOON + HomeKeyService.SCREEN_ON_WINDOW_MS));
         assertFalse(HomeKeyService.stillArmed(SOON, 0));
     }
+
+    @Test public void redirectAppsMapsEachPackageToItsTarget() {
+        Map<String, String> to = HomeKeyService.parseRedirects(Arrays.asList(
+                "com.amazon.tv.livetv:com.example.iptv", " com.a : com.b/.Main "));
+        assertEquals(2, to.size());
+        assertEquals("com.example.iptv", to.get("com.amazon.tv.livetv"));
+        assertEquals("com.b/.Main", to.get("com.a"));
+    }
+
+    @Test public void redirectAppsSkipsBrokenAndSelfEntries() {
+        assertTrue(HomeKeyService.parseRedirects(Arrays.asList("", "nocolon", ":com.b", "com.a:", "com.a:com.a")).isEmpty());
+    }
 }
