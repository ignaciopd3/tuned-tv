diff --git a/launcher/app/src/main/java/com/gathin/tvhome/ClockCasa.java b/launcher/app/src/main/java/com/gathin/tvhome/ClockCasa.java
new file mode 100644
index 0000000..42ede86
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/ClockCasa.java
@@ -0,0 +1,173 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * casa_row on the clock screens (ClockActivity and the ClockDream screensaver): the weather line goes under an
+ * "Outside" label and Casa's living-room temperature and humidity sit beside it under "Home", read from Casa's provider
+ * and kept current while the clock shows. Without a reading from Casa the labels and the Home column hide, and the
+ * weather line looks as it always did.
+ */
+final class ClockCasa {
+    private static final String NO_VALUE = "—";
+
+    private final Context ctx;
+    private final Uri now;
+    private final float density;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private final TextView weatherLine, outsideLabel, temperature, humidity;
+    private final LinearLayout homeColumn;
+    private final ContentObserver observer;
+    private boolean watching, hasReading;
+
+    /** The columns when Casa is installed and answers; null otherwise, and the clock stays as it was. */
+    static ClockCasa attach(Context ctx, View root, String pkg) {
+        if (pkg == null || pkg.isEmpty() || ctx.getPackageManager().resolveContentProvider(pkg + ".now", 0) == null) return null;
+        return new ClockCasa(ctx, root, pkg);
+    }
+
+    private ClockCasa(Context ctx, View root, String pkg) {
+        this.ctx = ctx;
+        this.now = Uri.parse("content://" + pkg + ".now/now");
+        this.density = ctx.getResources().getDisplayMetrics().density;
+        weatherLine = root.findViewById(R.id.dreamWeather);
+        ViewGroup block = (ViewGroup) weatherLine.getParent();
+        int at = block.indexOfChild(weatherLine);
+        ViewGroup.LayoutParams lineParams = weatherLine.getLayoutParams();
+        block.removeView(weatherLine);
+
+        LinearLayout outside = column();
+        outsideLabel = label(R.string.clock_outside);
+        outside.addView(outsideLabel);
+        outside.addView(weatherLine, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        homeColumn = column();
+        homeColumn.addView(label(R.string.clock_home));
+        LinearLayout values = new LinearLayout(ctx);
+        values.setOrientation(LinearLayout.HORIZONTAL);
+        temperature = value(R.drawable.ic_casa_house);
+        humidity = value(R.drawable.ic_casa_drop);
+        values.addView(temperature);
+        LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        hlp.setMarginStart(px(18));
+        values.addView(humidity, hlp);
+        homeColumn.addView(values);
+
+        LinearLayout pair = new LinearLayout(ctx);
+        pair.setOrientation(LinearLayout.HORIZONTAL);
+        pair.addView(outside);
+        pair.addView(homeColumn, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+        block.addView(pair, at, lineParams);   // where the weather line was, with its margins
+
+        observer = new ContentObserver(main) {
+            @Override
+            public void onChange(boolean selfChange) {
+                refresh();
+            }
+        };
+        relabel();
+    }
+
+    private LinearLayout column() {
+        LinearLayout c = new LinearLayout(ctx);
+        c.setOrientation(LinearLayout.VERTICAL);
+        return c;
+    }
+
+    /** A small spaced capital label, quieter than the line under it. */
+    private TextView label(int text) {
+        TextView t = new TextView(ctx);
+        t.setText(text);
+        t.setAllCaps(true);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        t.setLetterSpacing(0.2f);
+        t.setTextColor(0x80FFFFFF);
+        t.setTypeface(weatherLine.getTypeface());
+        t.setPaddingRelative(0, 0, 0, px(6));
+        return t;
+    }
+
+    /** A value in the weather line's own size, colour and icon tint. */
+    private TextView value(int icon) {
+        TextView t = new TextView(ctx);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_PX, weatherLine.getTextSize());
+        t.setTextColor(weatherLine.getTextColors());
+        t.setTypeface(weatherLine.getTypeface());
+        t.setLetterSpacing(weatherLine.getLetterSpacing());
+        t.setGravity(weatherLine.getGravity());
+        android.graphics.drawable.Drawable d = ctx.getDrawable(icon);
+        int size = Math.round(weatherLine.getTextSize() * 1.25f);   // as tall as the weather icon beside it
+        d.setBounds(0, 0, size, size);
+        t.setCompoundDrawablesRelative(d, null, null, null);
+        t.setCompoundDrawablePadding(px(8));
+        t.setCompoundDrawableTintList(weatherLine.getCompoundDrawableTintList());
+        t.setSingleLine(true);
+        t.setText(NO_VALUE);
+        return t;
+    }
+
+    /** Labels only when both columns show; without the weather the Home column starts where the line did. */
+    void relabel() {
+        boolean weatherShown = weatherLine.getVisibility() == View.VISIBLE;
+        homeColumn.setVisibility(hasReading ? View.VISIBLE : View.GONE);
+        outsideLabel.setVisibility(hasReading && weatherShown ? View.VISIBLE : View.GONE);
+        homeColumn.getChildAt(0).setVisibility(hasReading && weatherShown ? View.VISIBLE : View.GONE);
+        LinearLayout.LayoutParams lp = (LinearLayout.LayoutParams) homeColumn.getLayoutParams();
+        lp.setMarginStart(weatherShown ? px(48) : 0);
+        homeColumn.setLayoutParams(lp);
+    }
+
+    void start() {
+        if (!watching) {
+            ctx.getContentResolver().registerContentObserver(now, false, observer);
+            watching = true;
+        }
+        refresh();
+    }
+
+    void stop() {
+        if (watching) ctx.getContentResolver().unregisterContentObserver(observer);
+        watching = false;
+    }
+
+    private void refresh() {
+        io.execute(() -> {
+            String t = NO_VALUE, h = NO_VALUE;
+            try (Cursor c = ctx.getContentResolver().query(now, null, null, null, null)) {
+                if (c != null && c.moveToFirst()) {
+                    t = c.getString(c.getColumnIndexOrThrow("temperature"));
+                    h = c.getString(c.getColumnIndexOrThrow("humidity"));
+                }
+            } catch (RuntimeException unavailable) {
+                // Casa is starting or gone: no Home column until it answers.
+            }
+            String ft = t, fh = h;
+            main.post(() -> {
+                hasReading = ft != null && !NO_VALUE.equals(ft);
+                temperature.setText(ft);
+                humidity.setText(fh);
+                relabel();
+            });
+        });
+    }
+
+    private int px(float dp) {
+        return Math.round(dp * density);
+    }
+}
