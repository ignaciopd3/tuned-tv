diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/NowProvider.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/NowProvider.java
new file mode 100644
index 0000000..f497ab9
--- /dev/null
+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/NowProvider.java
@@ -0,0 +1,104 @@
+package io.github.sumyabazar1.weather;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.Resources;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * The weather now, for a home screen that stays offline (Clean Your TV's weather_app): one row of ready-to-show
+ * text from a cached fetch. A read with a copy older than {@link Forecast#REFRESH_MS} fetches in the background and
+ * notifies the URI when done; nothing runs when nobody reads. No place name or position is published.
+ */
+public final class NowProvider extends ContentProvider {
+    static final String AUTHORITY = "io.github.sumyabazar1.weather.now";
+    static final Uri URI = Uri.parse("content://" + AUTHORITY + "/now");
+    private static final String[] COLUMNS = {"temp", "summary", "days", "code", "is_day"};
+    private static final int DAYS_SHOWN = 2;
+
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private final AtomicBoolean fetching = new AtomicBoolean();
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] args, String sortOrder) {
+        Context ctx = getContext();
+        MatrixCursor out = new MatrixCursor(COLUMNS, 1);
+        out.setNotificationUri(ctx.getContentResolver(), URI);
+        SharedPreferences place = ctx.getSharedPreferences("place", Context.MODE_PRIVATE);
+        if (!place.contains("name")) return out;
+        long lat = place.getLong("lat", 0);
+        long lon = place.getLong("lon", 0);
+        SharedPreferences now = ctx.getSharedPreferences("now", Context.MODE_PRIVATE);
+        boolean sameCity = now.contains("lat") && now.getLong("lat", 0) == lat && now.getLong("lon", 0) == lon;
+        if (NowText.needsFetch(System.currentTimeMillis(), now.getLong("fetched", 0), now.getLong("tried", 0), sameCity)) {
+            fetch(ctx, now, lat, lon);
+        }
+        if (sameCity) {
+            out.addRow(new Object[] {now.getString("temp", ""), now.getString("summary", ""), now.getString("days", ""),
+                    now.getInt("code", 3), now.getInt("is_day", 1)});
+        }
+        return out;
+    }
+
+    private void fetch(Context ctx, SharedPreferences now, long lat, long lon) {
+        if (!fetching.compareAndSet(false, true)) return;
+        now.edit().putLong("tried", System.currentTimeMillis()).apply();
+        Resources res = ctx.getResources();
+        boolean f = ctx.getSharedPreferences("options", Context.MODE_PRIVATE)
+                .getBoolean("fahrenheit", "f".equalsIgnoreCase(res.getString(R.string.temperature_unit).trim()));
+        io.execute(() -> {
+            try {
+                Forecast.Report r = Forecast.fetch(Double.longBitsToDouble(lat), Double.longBitsToDouble(lon), Forecast.MIN_DAYS);
+                now.edit()
+                        .putLong("lat", lat)
+                        .putLong("lon", lon)
+                        .putLong("fetched", System.currentTimeMillis())
+                        .putString("temp", Forecast.degrees(r.tempC, f) + "°")
+                        .putString("summary", res.getString(Forecast.sky(r.code, r.day)) + " · "
+                                + res.getString(R.string.feels_like, Forecast.degrees(r.feelsC, f)))
+                        .putString("days", NowText.days(r.days, DAYS_SHOWN, Locale.getDefault(), f))
+                        .putInt("code", r.code)
+                        .putInt("is_day", r.day ? 1 : 0)
+                        .apply();
+                ctx.getContentResolver().notifyChange(URI, null);
+            } catch (Exception offline) {
+                // Offline or Open-Meteo down: the last copy stays, and a read after RETRY_MS tries again.
+            } finally {
+                fetching.set(false);
+            }
+        });
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return null;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        return null;
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] args) {
+        return 0;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] args) {
+        return 0;
+    }
+}
diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/NowText.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/NowText.java
