@@ -0,0 +1,36 @@
+package com.gathin.tvhome;
+
+/**
+ * adb_warning_app (config.xml or a theme): a red button in the top bar while ADB can be reached over the network,
+ * opening the named app (such as Remote Access) to switch it off. Same rule as that add-on: wireless debugging,
+ * or the developer switch on with a TCP port (adb tcpip). USB only, or a port left over with the switch off, is
+ * not network ADB.
+ */
+final class AdbWarning {
+    private AdbWarning() { }
+
+    static boolean network(boolean enabled, boolean wireless, int tcpPort) {
+        return wireless || (enabled && tcpPort > 0);
+    }
+
+    /** android.os.SystemProperties is hidden but readable; empty when the firmware refuses it. */
+    static String prop(String name) {
+        try {
+            Object v = Class.forName("android.os.SystemProperties").getMethod("get", String.class).invoke(null, name);
+            return v instanceof String ? (String) v : "";
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            return "";
+        }
+    }
+
+    /** -1 for an unset, empty or odd service.adb.tcp.port value. */
+    static int port(String prop) {
+        if (prop == null) return -1;
+        try {
+            int p = Integer.parseInt(prop.trim());
+            return p > 0 && p < 65536 ? p : -1;
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+}
