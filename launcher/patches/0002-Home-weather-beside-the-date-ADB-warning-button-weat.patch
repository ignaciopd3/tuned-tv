      * {@value #META} meta-data. Naming the package is the owner's opt-in.
      */
     static GameDay create(Context ctx, String pkg, Handler main, Runnable onChange) {
+        Uri uri = ownProviderUri(ctx, pkg, META, "turns");
+        return uri == null ? null : new GameDay(ctx, uri, main, onChange);
+    }
+
+    /**
+     * content://authority/path for the provider that {@code pkg} names in its {@code meta} meta-data; null when the
+     * key is empty, the package is missing or names none, or the authority is another app's. Also used by
+     * {@link WeatherNow}.
