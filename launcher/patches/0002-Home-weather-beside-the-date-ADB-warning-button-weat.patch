diff --git a/launcher/app/src/test/java/com/gathin/tvhome/AdbWarningTest.java b/launcher/app/src/test/java/com/gathin/tvhome/AdbWarningTest.java
new file mode 100644
index 0000000..52cf2f6
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/AdbWarningTest.java
@@ -0,0 +1,38 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class AdbWarningTest {
+    @Test
+    public void debuggingOffHidesTheWarningEvenWithALeftoverPort() {
+        assertFalse(AdbWarning.network(false, false, 5555));
+        assertFalse(AdbWarning.network(false, false, -1));
+    }
+
+    @Test
+    public void usbOnlyIsNotReachableFromTheNetwork() {
+        assertFalse(AdbWarning.network(true, false, -1));
+    }
+
+    @Test
+    public void aTcpPortOrWirelessDebuggingIsNetworkAdb() {
+        assertTrue(AdbWarning.network(true, false, 5555));
+        assertTrue(AdbWarning.network(false, true, -1));
+    }
+
+    @Test
+    public void portReadsOnlyARealPort() {
+        assertEquals(5555, AdbWarning.port("5555"));
+        assertEquals(5555, AdbWarning.port(" 5555 "));
+        assertEquals(-1, AdbWarning.port(null));
+        assertEquals(-1, AdbWarning.port(""));
+        assertEquals(-1, AdbWarning.port("0"));
+        assertEquals(-1, AdbWarning.port("-1"));
+        assertEquals(-1, AdbWarning.port("70000"));
+        assertEquals(-1, AdbWarning.port("adb"));
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/WeatherNowTest.java b/launcher/app/src/test/java/com/gathin/tvhome/WeatherNowTest.java
new file mode 100644
index 0000000..858fe89
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/WeatherNowTest.java
@@ -0,0 +1,53 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class WeatherNowTest {
+    @Test
+    public void aRowWithATemperatureIsTheWeather() {
+        WeatherNow.Now now = WeatherNow.fromRow(new Object[] {"15°", "Nublado · Sensación 14°", "mié 17°/15° · jue 16°/9°", 3, 0});
+        assertEquals("15°", now.temp);
+        assertEquals("Nublado · Sensación 14°", now.summary);
+        assertEquals("mié 17°/15° · jue 16°/9°", now.days);
+        assertEquals(3, now.code);
+        assertFalse(now.day);
+    }
+
+    @Test
+    public void noRowOrNoTemperatureIsNoWeather() {
+        assertNull(WeatherNow.fromRow(null));
+        assertNull(WeatherNow.fromRow(new Object[] {"", "Nublado", "", 3, 1}));
+        assertNull(WeatherNow.fromRow(new Object[] {null, "Nublado", "", 3, 1}));
+    }
+
+    @Test
+    public void missingTextsAndNumbersFallBack() {
+        WeatherNow.Now now = WeatherNow.fromRow(new Object[] {" 9° ", null, null, null, null});
+        assertEquals("9°", now.temp);
+        assertEquals("", now.summary);
+        assertEquals("", now.days);
+        assertEquals(3, now.code);
+        assertTrue(now.day);
+    }
+
+    @Test
+    public void iconsFollowTheWmoCode() {
+        assertEquals(R.drawable.ic_weather_sun, WeatherNow.icon(0, true));
+        assertEquals(R.drawable.ic_weather_moon, WeatherNow.icon(1, false));
+        assertEquals(R.drawable.ic_weather_partly, WeatherNow.icon(2, true));
+        assertEquals(R.drawable.ic_weather_cloud, WeatherNow.icon(3, false));
+        assertEquals(R.drawable.ic_weather_fog, WeatherNow.icon(45, true));
+        assertEquals(R.drawable.ic_weather_rain, WeatherNow.icon(51, true));
+        assertEquals(R.drawable.ic_weather_rain, WeatherNow.icon(66, true));
+        assertEquals(R.drawable.ic_weather_rain, WeatherNow.icon(81, true));
+        assertEquals(R.drawable.ic_weather_snow, WeatherNow.icon(73, true));
+        assertEquals(R.drawable.ic_weather_snow, WeatherNow.icon(86, true));
+        assertEquals(R.drawable.ic_weather_storm, WeatherNow.icon(95, false));
+        assertEquals(R.drawable.ic_weather_cloud, WeatherNow.icon(42, true));
+    }
+}
