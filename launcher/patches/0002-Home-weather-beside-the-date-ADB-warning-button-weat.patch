+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/NowText.java
@@ -0,0 +1,35 @@
+package io.github.sumyabazar1.weather;
+
+import java.time.format.TextStyle;
+import java.util.List;
+import java.util.Locale;
+
+/** The weather in a few words for a home screen (NowProvider): pure, so the JVM tests cover it. */
+final class NowText {
+    private NowText() { }
+
+    /** "mié 17°/15° · jue 16°/9°": the first {@code n} days, short names without the abbreviation dot. */
+    static String days(List<Forecast.Day> days, int n, Locale locale, boolean fahrenheit) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < Math.min(n, days.size()); i++) {
+            Forecast.Day d = days.get(i);
+            String name = d.date.getDayOfWeek().getDisplayName(TextStyle.SHORT, locale);
+            if (name.endsWith(".")) name = name.substring(0, name.length() - 1);
+            if (out.length() > 0) out.append(" · ");
+            out.append(name).append(' ').append(Forecast.degrees(d.maxC, fahrenheit)).append("°/")
+                    .append(Forecast.degrees(d.minC, fahrenheit)).append('°');
+        }
+        return out.toString();
+    }
+
+    /**
+     * Whether a read should fetch: always for another city, otherwise only once the cache is older than
+     * {@link Forecast#REFRESH_MS} (or from a clock that went back), and not again within {@link Forecast#RETRY_MS}
+     * of the last try, so an offline TV is not asked on every return to Home.
+     */
+    static boolean needsFetch(long now, long fetchedMs, long lastTryMs, boolean sameCity) {
+        if (!sameCity) return true;
+        boolean stale = fetchedMs <= 0 || fetchedMs > now || now - fetchedMs >= Forecast.REFRESH_MS;
+        return stale && (lastTryMs > now || now - lastTryMs >= Forecast.RETRY_MS);
+    }
+}
diff --git a/addons/weather/app/src/test/java/io/github/sumyabazar1/weather/NowTextTest.java b/addons/weather/app/src/test/java/io/github/sumyabazar1/weather/NowTextTest.java
