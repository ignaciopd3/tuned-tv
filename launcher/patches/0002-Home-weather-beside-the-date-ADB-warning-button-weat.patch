diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WeatherNow.java b/launcher/app/src/main/java/com/gathin/tvhome/WeatherNow.java
new file mode 100644
index 0000000..81790bd
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WeatherNow.java
@@ -0,0 +1,151 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Handler;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+
+/**
+ * weather_app (config.xml or a theme): the weather now beside the date and under the screensaver clock, from an
+ * add-on that publishes it (a {@value #META} meta-data naming its provider; one row at content://authority/now).
+ * The launcher stays offline: the add-on fetches when read. Same opt-in and checks as {@link GameDay}.
+ */
+final class WeatherNow {
+    static final String META = "com.gathin.tvhome.weather";
+    private static final String[] COLUMNS = {"temp", "summary", "days", "code", "is_day"};
+
+    /** One reading: ready-to-show texts, and the WMO code and day or night for the icon. */
+    static final class Now {
+        final String temp;
+        final String summary;
+        final String days;
+        final int code;
+        final boolean day;
+
+        Now(String temp, String summary, String days, int code, boolean day) {
+            this.temp = temp;
+            this.summary = summary;
+            this.days = days;
+            this.code = code;
+            this.day = day;
+        }
+    }
+
+    private final Context ctx;
+    private final Uri uri;
+    private final Handler main;
+    private final Runnable onChange;
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private final ContentObserver observer;
+    /** Asked again this often while on screen (the screensaver runs for hours); the add-on fetches only when stale. */
+    private static final long REREAD_MS = 30 * 60_000L;
+    private final Runnable reread = this::rereadTick;
+    private boolean watching;
+    private Now now;
+
+    private WeatherNow(Context ctx, Uri uri, Handler main, Runnable onChange) {
+        this.ctx = ctx;
+        this.uri = uri;
+        this.main = main;
+        this.onChange = onChange;
+        observer = new ContentObserver(main) {
+            @Override
+            public void onChange(boolean selfChange) {
+                read();
+            }
+        };
+    }
+
+    /** Null when the key is empty or the package publishes no weather of its own. */
+    static WeatherNow create(Context ctx, String pkg, Handler main, Runnable onChange) {
+        Uri uri = GameDay.ownProviderUri(ctx, pkg, META, "now");
+        return uri == null ? null : new WeatherNow(ctx, uri, main, onChange);
+    }
+
+    /** On screen: read now (the add-on fetches if its copy is old) and watch for the fresh one. */
+    void start() {
+        if (!watching) {
+            try {
+                ctx.getContentResolver().registerContentObserver(uri, false, observer);
+                watching = true;
+            } catch (SecurityException e) {
+                // The add-on's provider went away; the line keeps what it had.
+            }
+        }
+        read();
+        main.removeCallbacks(reread);
+        main.postDelayed(reread, REREAD_MS);
+    }
+
+    private void rereadTick() {
+        read();
+        main.postDelayed(reread, REREAD_MS);
+    }
+
+    /** Off screen: nothing is read, so the add-on fetches nothing. */
+    void stop() {
+        main.removeCallbacks(reread);
+        if (watching) ctx.getContentResolver().unregisterContentObserver(observer);
+        watching = false;
+    }
+
+    void shutdown() {
+        stop();
+        io.shutdownNow();
+    }
+
+    /** One query off the main thread (the provider lives in the add-on's process), then onChange on the main thread. */
+    void read() {
+        try {
+            io.execute(() -> {
+                Object[] row = null;
+                try (Cursor c = ctx.getContentResolver().query(uri, COLUMNS, null, null, null)) {
+                    if (c != null && c.moveToFirst()) {
+                        row = new Object[] {c.getString(0), c.getString(1), c.getString(2), c.getInt(3), c.getInt(4)};
+                    }
+                } catch (RuntimeException gone) {
+                    // Uninstalled, crashed or not allowed to start: keep what is on screen.
+                    return;
+                }
+                Now parsed = fromRow(row);
+                main.post(() -> {
+                    now = parsed;
+                    onChange.run();
+                });
+            });
+        } catch (RejectedExecutionException shutDown) {
+            // Being destroyed.
+        }
+    }
+
+    Now now() {
+        return now;
+    }
+
+    /** The add-on's row, or null when there is none or it has no temperature (no city chosen, first fetch running). */
+    static Now fromRow(Object[] r) {
+        if (r == null || !(r[0] instanceof String) || ((String) r[0]).trim().isEmpty()) return null;
+        int code = r[3] instanceof Number ? ((Number) r[3]).intValue() : 3;
+        boolean day = !(r[4] instanceof Number) || ((Number) r[4]).intValue() != 0;
+        return new Now(((String) r[0]).trim(), text(r[1]), text(r[2]), code, day);
+    }
+
+    private static String text(Object o) {
+        return o instanceof String ? ((String) o).trim() : "";
+    }
+
+    /** The WMO weather code as one of eight line icons; clear skies show the sun by day and the moon by night. */
+    static int icon(int code, boolean day) {
+        if (code == 0 || code == 1) return day ? R.drawable.ic_weather_sun : R.drawable.ic_weather_moon;
+        if (code == 2) return R.drawable.ic_weather_partly;
+        if (code == 45 || code == 48) return R.drawable.ic_weather_fog;
+        if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return R.drawable.ic_weather_rain;
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return R.drawable.ic_weather_snow;
+        if (code >= 95) return R.drawable.ic_weather_storm;
+        return R.drawable.ic_weather_cloud;
+    }
+}
