+++ b/addons/weather/app/src/test/java/io/github/sumyabazar1/weather/NowTextTest.java
@@ -0,0 +1,63 @@
+package io.github.sumyabazar1.weather;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.time.LocalDate;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import org.junit.Test;
+
+public class NowTextTest {
+    private static final long MIN = 60_000L;
+    private static final List<Forecast.Day> DAYS = Arrays.asList(
+            new Forecast.Day(LocalDate.of(2026, 11, 18), 63, 17.2, 14.6),
+            new Forecast.Day(LocalDate.of(2026, 11, 19), 80, 15.6, 9.4),
+            new Forecast.Day(LocalDate.of(2026, 11, 20), 3, 14.0, 8.0));
+
+    @Test
+    public void daysJoinsTheFirstOnesWithoutTheAbbreviationDot() {
+        assertEquals("mié 17°/15° · jue 16°/9°", NowText.days(DAYS, 2, new Locale("es", "ES"), false));
+    }
+
+    @Test
+    public void daysInFahrenheitAndEnglish() {
+        assertEquals("Wed 63°/58°", NowText.days(DAYS, 1, Locale.US, true));
+    }
+
+    @Test
+    public void daysWithFewerThanAskedShowsWhatThereIs() {
+        assertEquals("", NowText.days(Collections.emptyList(), 2, Locale.US, false));
+        assertEquals("Wed 17°/15° · Thu 16°/9° · Fri 14°/8°", NowText.days(DAYS, 5, Locale.US, false));
+    }
+
+    @Test
+    public void fetchesWithoutCacheOrForAnotherCity() {
+        long now = 1_000 * MIN;
+        assertTrue(NowText.needsFetch(now, 0, 0, true));
+        assertTrue(NowText.needsFetch(now, now - MIN, now - MIN, false));
+    }
+
+    @Test
+    public void freshCacheIsServedAsIs() {
+        long now = 1_000 * MIN;
+        assertFalse(NowText.needsFetch(now, now - 29 * MIN, now - 29 * MIN, true));
+    }
+
+    @Test
+    public void staleCacheFetchesUnlessATryWasRecent() {
+        long now = 1_000 * MIN;
+        assertTrue(NowText.needsFetch(now, now - 31 * MIN, now - 31 * MIN, true));
+        assertFalse(NowText.needsFetch(now, now - 31 * MIN, now - 2 * MIN, true));
+        assertTrue(NowText.needsFetch(now, now - 31 * MIN, now - 6 * MIN, true));
+    }
+
+    @Test
+    public void aClockThatWentBackCountsAsStale() {
+        long now = 1_000 * MIN;
+        assertTrue(NowText.needsFetch(now, now + 60 * MIN, now + 60 * MIN, true));
+    }
+}
