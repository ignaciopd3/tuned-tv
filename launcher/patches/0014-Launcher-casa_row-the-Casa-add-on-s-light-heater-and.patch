diff --git a/launcher/app/src/main/java/com/gathin/tvhome/CasaRow.java b/launcher/app/src/main/java/com/gathin/tvhome/CasaRow.java
new file mode 100644
index 0000000..f12e8fe
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/CasaRow.java
@@ -0,0 +1,201 @@
+package com.gathin.tvhome;
+
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.res.ColorStateList;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.graphics.drawable.GradientDrawable;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.RelativeLayout;
+import android.widget.TextView;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * casa_row: a second row under the top-bar capsule, inside the same dark glass, for the Casa add-on (tv-opt): the
+ * living-room light and the heater (OK switches them; the icon turns amber or orange while on) and the room's
+ * temperature and humidity, read from Casa's provider and kept current with a ContentObserver. The top bar moves up
+ * to the header capsule's top so both rows fit in the header's height and nothing below moves.
+ */
+final class CasaRow {
+    private static final int AMBER = 0xFFFFC44D, ORANGE = 0xFFFF8A4C, INK = 0xFF111111;
+
+    private final MainActivity activity;
+    private final String pkg;
+    private final Uri now;
+    private final float density;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private TextView light, heater, temperature, humidity;
+    private final ContentObserver observer;
+    private boolean watching;
+
+    private CasaRow(MainActivity activity, String pkg) {
+        this.activity = activity;
+        this.pkg = pkg;
+        this.now = Uri.parse("content://" + pkg + ".now/now");
+        this.density = activity.getResources().getDisplayMetrics().density;
+        this.observer = new ContentObserver(main) {
+            @Override
+            public void onChange(boolean selfChange) {
+                refresh();
+            }
+        };
+    }
+
+    /** Adds the row when Casa is installed and answers; null otherwise, and the top bar stays as it was. */
+    static CasaRow attach(MainActivity activity, String pkg, LinearLayout bar, int leftBlockId) {
+        if (pkg.isEmpty() || activity.getPackageManager().resolveContentProvider(pkg + ".now", 0) == null) return null;
+        CasaRow row = new CasaRow(activity, pkg);
+        row.build(bar, leftBlockId);
+        return row;
+    }
+
+    private void build(LinearLayout bar, int leftBlockId) {
+        RelativeLayout.LayoutParams blp = (RelativeLayout.LayoutParams) bar.getLayoutParams();
+        blp.removeRule(RelativeLayout.CENTER_VERTICAL);
+        blp.addRule(RelativeLayout.ALIGN_TOP, leftBlockId);
+        bar.setLayoutParams(blp);
+        bar.setBackground(glass(true));
+
+        LinearLayout row = new LinearLayout(activity);
+        row.setId(View.generateViewId());
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setBackground(glass(false));
+        row.setPaddingRelative(bar.getPaddingStart(), bar.getPaddingTop(), bar.getPaddingEnd(), bar.getPaddingBottom());
+        row.setClipToPadding(false);
+        row.setClipChildren(false);
+
+        light = button(R.drawable.ic_casa_bulb, R.string.casa_light, "LuzActivity", bar);
+        heater = button(R.drawable.ic_casa_heat, R.string.casa_heater, "CalefactorActivity", bar);
+        row.addView(light);
+        row.addView(heater);
+        LinearLayout climate = new LinearLayout(activity);
+        climate.setOrientation(LinearLayout.HORIZONTAL);
+        climate.setGravity(Gravity.CENTER_VERTICAL);
+        climate.setFocusable(false);
+        climate.addView(icon(R.drawable.ic_casa_thermo));
+        temperature = value();
+        climate.addView(temperature);
+        climate.addView(icon(R.drawable.ic_casa_drop));
+        humidity = value();
+        climate.addView(humidity);
+        LinearLayout.LayoutParams clp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, px(42));
+        clp.setMarginStart(px(14));
+        row.addView(climate, clp);
+
+        RelativeLayout.LayoutParams rlp = new RelativeLayout.LayoutParams(RelativeLayout.LayoutParams.WRAP_CONTENT,
+                RelativeLayout.LayoutParams.WRAP_CONTENT);
+        rlp.addRule(RelativeLayout.BELOW, bar.getId());
+        rlp.addRule(RelativeLayout.ALIGN_START, bar.getId());
+        rlp.addRule(RelativeLayout.ALIGN_END, bar.getId());
+        ((RelativeLayout) bar.getParent()).addView(row, rlp);
+    }
+
+    /** An icon-only top button, the same style and size as the ones above it. */
+    private TextView button(int icon, int label, String activityName, LinearLayout bar) {
+        TextView b = new TextView(activity, null, 0, R.style.TopButton);
+        b.setCompoundDrawablesRelativeWithIntrinsicBounds(icon, 0, 0, 0);
+        b.setContentDescription(activity.getString(label));
+        b.setPaddingRelative(px(10), 0, px(10), 0);
+        b.setCompoundDrawablePadding(0);
+        if (bar.getChildCount() > 0) b.setBackground(bar.getChildAt(0).getBackground().getConstantState().newDrawable());
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(px(42), px(42));
+        lp.setMarginStart(px(4));
+        b.setLayoutParams(lp);
+        b.setOnClickListener(v -> {
+            try {
+                activity.startActivity(new Intent().setComponent(new ComponentName(pkg, pkg + "." + activityName)));
+            } catch (RuntimeException gone) {
+                // Casa was removed or refused: nothing to switch.
+            }
+        });
+        tint(b, null, AMBER);
+        return b;
+    }
+
+    private ImageView icon(int res) {
+        ImageView i = new ImageView(activity);
+        i.setImageResource(res);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(px(22), px(22));
+        lp.setMarginEnd(px(6));
+        lp.setMarginStart(px(4));
+        i.setLayoutParams(lp);
+        return i;
+    }
+
+    private TextView value() {
+        TextView t = new TextView(activity);
+        t.setTextColor(0xFFFFFFFF);
+        t.setTextSize(15);
+        t.setText("—");
+        t.setPaddingRelative(0, 0, px(6), 0);
+        return t;
+    }
+
+    /** Ink while focused (the button turns white), the colour while on, white while off or unknown. */
+    private static void tint(TextView b, Boolean on, int color) {
+        int rest = Boolean.TRUE.equals(on) ? color : 0xFFFFFFFF;
+        b.setCompoundDrawableTintList(new ColorStateList(new int[][] {{android.R.attr.state_focused}, {}}, new int[] {INK, rest}));
+    }
+
+    /** The top piece keeps its upper corners round, the row its lower ones, so the two read as one block. */
+    private GradientDrawable glass(boolean top) {
+        GradientDrawable g = new GradientDrawable();
+        g.setColor(0x8C080A10);
+        float r = 27 * density;
+        g.setCornerRadii(top ? new float[] {r, r, r, r, 0, 0, 0, 0} : new float[] {0, 0, 0, 0, r, r, r, r});
+        g.setStroke(Math.max(1, Math.round(density)), 0x24FFFFFF);
+        return g;
+    }
+
+    void start() {
+        if (!watching) {
+            activity.getContentResolver().registerContentObserver(now, false, observer);
+            watching = true;
+        }
+        refresh();
+    }
+
+    void stop() {
+        if (watching) activity.getContentResolver().unregisterContentObserver(observer);
+        watching = false;
+    }
+
+    private void refresh() {
+        io.execute(() -> {
+            Integer l = null, h = null;
+            String t = "—", hu = "—";
+            try (Cursor c = activity.getContentResolver().query(now, null, null, null, null)) {
+                if (c != null && c.moveToFirst()) {
+                    l = c.getInt(c.getColumnIndexOrThrow("luz"));
+                    h = c.getInt(c.getColumnIndexOrThrow("calefactor"));
+                    t = c.getString(c.getColumnIndexOrThrow("temperature"));
+                    hu = c.getString(c.getColumnIndexOrThrow("humidity"));
+                }
+            } catch (RuntimeException unavailable) {
+                // Casa is busy starting or gone: keep the dashes.
+            }
+            Integer fl = l, fh = h;
+            String ft = t, fhu = hu;
+            main.post(() -> {
+                tint(light, fl == null || fl < 0 ? null : fl == 1, AMBER);
+                tint(heater, fh == null || fh < 0 ? null : fh == 1, ORANGE);
+                temperature.setText(ft);
+                humidity.setText(fhu);
+            });
+        });
+    }
+
+    private int px(float dp) {
+        return Math.round(dp * density);
+    }
+}
