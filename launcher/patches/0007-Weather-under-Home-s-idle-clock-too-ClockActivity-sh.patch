@@ -35,6 +35,13 @@ public class WeatherNowTest {
         assertTrue(now.day);
     }
 
+    @Test
+    public void theClockLineIsTheTemperatureAndTheSummary() {
+        assertEquals("15° · Nublado · Sensación 14°",
+                WeatherNow.clockLine(WeatherNow.fromRow(new Object[] {"15°", "Nublado · Sensación 14°", "", 3, 1})));
+        assertEquals("9°", WeatherNow.clockLine(WeatherNow.fromRow(new Object[] {"9°", null, null, null, null})));
+    }
+
     @Test
     public void iconsFollowTheWmoCode() {
         assertEquals(R.drawable.ic_weather_sun, WeatherNow.icon(0, true));
