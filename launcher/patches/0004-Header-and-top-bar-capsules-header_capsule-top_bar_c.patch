+    /**
+     * header_capsule: dark glass behind the greeting, clock, date and weather, sized to them. top_bar_capsule: the
+     * top buttons inside one dark glass capsule, level with the header's middle; each button drops its own glass and
+     * fills white only while focused. Runs before the VPN button keeps its plain background, so a VPN that goes down
+     * falls back to the capsule's button rather than a glass circle.
+     */
+    private void applyHeaderCapsules(Config cfg) {
+        if (cfg.headerCapsule) {
+            View block = findViewById(R.id.leftBlock);
+            block.setBackground(darkGlass(22));
+            block.setPaddingRelative(Math.round(20 * density), Math.round(12 * density),
+                    Math.round(24 * density), Math.round(14 * density));
+            ViewGroup.LayoutParams lp = block.getLayoutParams();
+            lp.width = ViewGroup.LayoutParams.WRAP_CONTENT;
+            block.setLayoutParams(lp);
+        }
+        if (!cfg.topBarCapsule) return;
+        LinearLayout bar = findViewById(R.id.topButtons);
+        int pad = Math.round(6 * density), gap = Math.round(4 * density);
+        bar.setBackground(darkGlass(27));
+        // Each button keeps a gap before it, so the start padding is short by that gap.
+        bar.setPaddingRelative(pad - gap, pad, pad, pad);
+        bar.setGravity(Gravity.CENTER_VERTICAL);
+        for (int i = 0; i < bar.getChildCount(); i++) {
+            View button = bar.getChildAt(i);
+            button.setBackground(capsuleButton());
+            ViewGroup.MarginLayoutParams mlp = (ViewGroup.MarginLayoutParams) button.getLayoutParams();
+            mlp.setMarginStart(gap);
+            button.setLayoutParams(mlp);
+        }
+        RelativeLayout.LayoutParams lp = (RelativeLayout.LayoutParams) bar.getLayoutParams();
+        lp.removeRule(RelativeLayout.ALIGN_BOTTOM);
+        lp.removeRule(RelativeLayout.ALIGN_TOP);
+        lp.addRule(RelativeLayout.CENTER_VERTICAL);
+        lp.topMargin = 0;
+        lp.bottomMargin = 0;
+        bar.setLayoutParams(lp);
+    }
+
+    /** The capsules' dark glass: translucent near-black with a faint white edge, like the dark dock band. */
+    private GradientDrawable darkGlass(int radiusDp) {
+        GradientDrawable glass = new GradientDrawable();
+        glass.setColor(0x8C080A10);
+        glass.setCornerRadius(radiusDp * density);
+        glass.setStroke(Math.max(1, Math.round(density)), 0x24FFFFFF);
+        return glass;
+    }
+
+    /** A button inside the top-bar capsule: clear at rest, white while focused, blue while reorder mode is on (pill_bg). */
+    private StateListDrawable capsuleButton() {
+        StateListDrawable bg = new StateListDrawable();
+        GradientDrawable focused = new GradientDrawable();
+        focused.setColor(0xF5FFFFFF);
+        focused.setCornerRadius(21 * density);
+        bg.addState(new int[]{android.R.attr.state_focused}, focused);
+        GradientDrawable reorder = new GradientDrawable();
+        reorder.setColor(0x596EC1FF);
+        reorder.setStroke(Math.round(1.5f * density), 0xFF6EC1FF);
+        reorder.setCornerRadius(21 * density);
+        bg.addState(new int[]{android.R.attr.state_activated}, reorder);
+        bg.addState(new int[0], new ColorDrawable(Color.TRANSPARENT));
+        return bg;
+    }
