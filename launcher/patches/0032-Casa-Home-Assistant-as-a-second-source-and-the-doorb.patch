+
+/**
+ * The doorbell card on screen, in the shape the owner picks from the mockup (https://claude.ai/artifact/GP9bgvq1UGGJRu6Bw13XPV):
+ * this is option 1, "Esquina", a third of the screen at the bottom right, and the only class that knows the shape.
+ * Dark glass like Casa's other messages: a header with the doorbell's name and the time, the live video, one button per
+ * opener plus Close, and a hint. It takes the remote while it shows (◀ ▶ move, OK held 1.5 s opens, Back closes), except
+ * for motion with video, which never takes it.
+ */
+final class TimbreCard {
+    interface Listener {
+        void onKey();
+
+        void onOpen(int which);
+
+        void onClose();
+    }
+
+    private static final int GREEN = 0xFF30D158, RED = 0xFFFF453A, INK = 0xFFEEF1F6, GLASS = 0xD1080A10;
+    private static final float WIDTH = 0.38f, MARGIN_X = 0.026f, MARGIN_Y = 0.04f;
+
+    private final Context ctx;
+    private final WindowManager wm;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final Bundle card;
+    private final boolean takesRemote;
+    private final Listener listener;
+    private final float dp;
+    private final List<HoldButton> buttons = new ArrayList<>();
+    private LinearLayout root;
+    private TextView title, sub, status, hint, badge;
+    private SurfaceViewRenderer renderer;
+    private int focus;
+    private Boolean shownCanOpen;   // what the buttons show now; null before the first setCanOpen
+    private long holdStart = -1;
+    private final Runnable holdTick = new Runnable() {
+        @Override
+        public void run() {
+            if (holdStart < 0) return;
+            long held = SystemClock.uptimeMillis() - holdStart;
+            HoldButton b = buttons.get(focus);
+            b.setProgress(DoorbellRules.holdProgress(held));
+            if (DoorbellRules.holdOpens(held)) {
+                holdStart = -1;
+                b.setProgress(0);
+                b.setText(ctx.getString(R.string.doorbell_opening));
+                listener.onOpen(focus);
+            } else {
+                main.postDelayed(this, 16);
+            }
+        }
+    };
+
+    TimbreCard(Context ctx, Bundle card, boolean takesRemote, Listener listener) {
+        this.ctx = ctx;
+        this.wm = ctx.getSystemService(WindowManager.class);
+        this.card = card;
+        this.takesRemote = takesRemote;
+        this.listener = listener;
+        this.dp = ctx.getResources().getDisplayMetrics().density;
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    void show(long now) {
