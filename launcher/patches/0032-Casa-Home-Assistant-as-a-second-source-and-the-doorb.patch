@@ -0,0 +1,73 @@
+package io.github.ignaciopd3.casa;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.ParcelFileDescriptor;
+import android.widget.Toast;
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+/**
+ * tv-opt's `run.py casa send` writes ha.json here with `content write`, so Home Assistant's token travels as a file,
+ * never on a command line; `content query` on /status says whether Casa took it and is connected. Only the ADB shell
+ * can do either (WRITE_SECURE_SETTINGS on the provider, as Smart Home and Frigate Glance do). The file is checked
+ * (HaConfig), kept in private preferences and deleted at once.
+ */
+public class ConfigProvider extends ContentProvider {
+    static final String FILE = "ha.json";
+    static final String[] STATUS = {"configured", "linked", "doorbells"};
+
+    @Override
+    public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        if (!mode.contains("w") || !FILE.equals(uri.getLastPathSegment())) throw new FileNotFoundException(uri.toString());
+        File f = new File(getContext().getFilesDir(), FILE);
+        try {
+            return ParcelFileDescriptor.open(f,
+                    ParcelFileDescriptor.MODE_WRITE_ONLY | ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_TRUNCATE,
+                    new Handler(Looper.getMainLooper()), e -> take(f));
+        } catch (IOException e) {
+            throw new FileNotFoundException(e.getMessage());
+        }
+    }
+
+    private void take(File f) {
+        boolean ok;
+        try {
+            Devices.saveHa(getContext(), new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8));
+            ok = true;
+        } catch (Exception e) {   // unreadable or refused by HaConfig: the previous configuration stays
+            ok = false;
+        } finally {
+            if (!f.delete()) f.deleteOnExit();
+        }
+        if (ok) {
+            CasaService s = CasaService.running();
+            if (s != null) s.reload();
+        }
+        Toast.makeText(getContext(), ok ? R.string.ha_saved : R.string.import_failed, Toast.LENGTH_LONG).show();
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] args, String order) {
+        if (!"status".equals(uri.getLastPathSegment())) return null;
+        HaConfig c = Devices.loadHa(getContext());
+        CasaService s = CasaService.running();
+        MatrixCursor out = new MatrixCursor(STATUS);
+        out.addRow(new Object[] {c != null ? 1 : 0, s != null && s.haLinked() ? 1 : 0, c == null ? 0 : c.doorbells.size()});
+        return out;
+    }
+
+    @Override public boolean onCreate() { return true; }
+    @Override public String getType(Uri uri) { return null; }
+    @Override public Uri insert(Uri uri, ContentValues values) { return null; }
+    @Override public int update(Uri uri, ContentValues v, String s, String[] a) { return 0; }
+    @Override public int delete(Uri uri, String s, String[] a) { return 0; }
+}
