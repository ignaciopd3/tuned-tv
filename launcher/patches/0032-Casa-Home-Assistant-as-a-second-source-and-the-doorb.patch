+            Toast.makeText(ctx, title(now), Toast.LENGTH_LONG).show();
+            return;
+        }
+        DisplayMetrics m = ctx.getResources().getDisplayMetrics();
+        int width = Math.round(m.widthPixels * WIDTH);
+        root = new LinearLayout(ctx);
+        root.setOrientation(LinearLayout.VERTICAL);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(GLASS);
+        bg.setCornerRadius(px(22));
+        bg.setStroke(Math.max(1, px(1)), 0x1FFFFFFF);
+        root.setBackground(bg);
+        int pad = px(14);
+        root.setPadding(pad, pad, pad, pad);
+
+        root.addView(header(now));
+        int videoW = width - 2 * pad;
+        FrameLayout videoBox = new FrameLayout(ctx);
+        videoBox.setBackgroundColor(0xFF1B222B);
+        renderer = new SurfaceViewRenderer(ctx);
+        renderer.setZOrderMediaOverlay(true);
+        videoBox.addView(renderer, new FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
+        status = text(ctx.getString(R.string.doorbell_connecting), 13, 0xBFFFFFFF, false);
+        videoBox.addView(status, new FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
+        badge = text(ctx.getString(R.string.doorbell_live), 11, Color.WHITE, true);
+        GradientDrawable red = new GradientDrawable();
+        red.setColor(RED);
+        red.setCornerRadius(px(5));
+        badge.setBackground(red);
+        badge.setPadding(px(7), px(2), px(7), px(2));
+        badge.setVisibility(View.GONE);
+        FrameLayout.LayoutParams blp = new FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.START);
+        blp.setMargins(px(8), px(8), 0, 0);
+        videoBox.addView(badge, blp);
+        LinearLayout.LayoutParams vlp = new LinearLayout.LayoutParams(videoW, videoW * 9 / 16);
+        vlp.topMargin = px(10);
+        root.addView(videoBox, vlp);
+
+        LinearLayout row = new LinearLayout(ctx);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        String[] labels = card.getStringArray(TimbreService.OPEN_LABELS);
+        String[] ids = card.getStringArray(TimbreService.OPEN_IDS);
+        for (int i = 0; labels != null && i < labels.length; i++) {
+            buttons.add(button(labels[i], ids[i].startsWith("lock.") ? R.drawable.ic_key : R.drawable.ic_portal, row));
+        }
+        buttons.add(button(ctx.getString(R.string.doorbell_close), R.drawable.ic_close, row));
+        LinearLayout.LayoutParams rlp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        rlp.topMargin = px(10);
+        root.addView(row, rlp);
+        hint = text("", 12, 0xFF98A1B0, false);
+        hint.setGravity(Gravity.CENTER_HORIZONTAL);
+        LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        hlp.topMargin = px(8);
+        root.addView(hint, hlp);
+
+        int flags = WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN;
+        if (!takesRemote) flags |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE;
+        WindowManager.LayoutParams lp = new WindowManager.LayoutParams(width, WindowManager.LayoutParams.WRAP_CONTENT,
+                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, flags, PixelFormat.TRANSLUCENT);
+        lp.gravity = Gravity.BOTTOM | Gravity.END;
+        lp.x = Math.round(m.widthPixels * MARGIN_X);
+        lp.y = Math.round(m.heightPixels * MARGIN_Y);
+        if (takesRemote) {
+            root.setFocusable(true);
+            root.setFocusableInTouchMode(true);
+            root.setOnKeyListener((v, code, ev) -> key(code, ev));
+        }
+        wm.addView(root, lp);
+        if (takesRemote) root.requestFocus();
+        paintFocus();
+    }
+
+    SurfaceViewRenderer renderer() {
+        return renderer;
+    }
+
+    /** Rung again while showing: the new time, and the open buttons are back if they had gone. */
+    void ringing(long now) {
+        if (title != null) title.setText(title(now));
+        if (sub != null) sub.setText(clock(now));
+    }
+
+    void live() {
+        if (status != null) status.setVisibility(View.GONE);
+        if (badge != null) badge.setVisibility(View.VISIBLE);
+    }
+
+    void noVideo() {
+        if (status != null) status.setText(card.getString(TimbreService.CAMERA) == null
+                ? ctx.getString(R.string.doorbell_no_camera) : ctx.getString(R.string.doorbell_no_video));
+        if (badge != null) badge.setVisibility(View.GONE);
+    }
+
+    /** Open buttons only while a real ring is recent; without them the remote can only close. */
+    void setCanOpen(boolean can) {
+        if (root == null || Boolean.valueOf(can).equals(shownCanOpen)) return;
+        shownCanOpen = can;
+        for (int i = 0; i < buttons.size() - 1; i++) buttons.get(i).setVisibility(can ? View.VISIBLE : View.GONE);
+        if (!can) focus = buttons.size() - 1;
+        hint.setText(buttons.size() == 1 ? ctx.getString(R.string.doorbell_hint_close)
+                : can ? ctx.getString(R.string.doorbell_hint_open) : ctx.getString(R.string.doorbell_hint_no_ring));
+        paintFocus();
+    }
+
+    /** Home Assistant's answer to an opening: the button says so for a few seconds. */
+    void opened(int which, boolean ok) {
+        if (which >= buttons.size() - 1) return;
+        HoldButton b = buttons.get(which);
+        b.setText(ctx.getString(ok ? R.string.doorbell_opened : R.string.doorbell_open_failed));
+        b.result = ok ? GREEN : RED;
+        paintFocus();
+        main.postDelayed(() -> {
+            b.result = 0;
+            b.setText(b.label);
+            paintFocus();
+        }, 4000);
+    }
+
+    void remove() {
+        main.removeCallbacksAndMessages(null);
+        if (root != null) {
+            wm.removeView(root);
+            root = null;
+        }
+    }
+
+    // ---- keys ----
+
+    private boolean key(int code, KeyEvent ev) {
+        boolean down = ev.getAction() == KeyEvent.ACTION_DOWN;
+        switch (code) {
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                if (down) {
+                    cancelHold();
+                    move(code == KeyEvent.KEYCODE_DPAD_RIGHT ? 1 : -1);
+                    listener.onKey();
+                }
+                return true;
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+            case KeyEvent.KEYCODE_ENTER:
+            case KeyEvent.KEYCODE_NUMPAD_ENTER:
+                if (down && ev.getRepeatCount() == 0) {
+                    listener.onKey();
+                    if (focus == buttons.size() - 1) {
+                        listener.onClose();
+                    } else {
+                        holdStart = SystemClock.uptimeMillis();
+                        main.post(holdTick);
+                    }
+                } else if (!down) {
+                    cancelHold();
+                }
+                return true;
+            case KeyEvent.KEYCODE_BACK:
+                if (!down) listener.onClose();
+                return true;
+            case KeyEvent.KEYCODE_DPAD_UP:
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+                return true;   // nothing above or below; keep them from the app underneath
+            default:
+                return false;
+        }
+    }
+
+    private void cancelHold() {
+        if (holdStart < 0) return;
+        holdStart = -1;
+        main.removeCallbacks(holdTick);
+        buttons.get(focus).setProgress(0);
+    }
+
+    private void move(int step) {
+        int n = buttons.size();
+        for (int i = 1; i <= n; i++) {
+            int next = ((focus + step * i) % n + n) % n;
+            if (buttons.get(next).getVisibility() == View.VISIBLE) {
+                focus = next;
+                break;
+            }
+        }
+        paintFocus();
+    }
+
+    private void paintFocus() {
+        for (int i = 0; i < buttons.size(); i++) buttons.get(i).paint(i == focus && takesRemote);
+    }
+
+    // ---- building ----
+
+    private LinearLayout header(long now) {
+        LinearLayout h = new LinearLayout(ctx);
+        h.setOrientation(LinearLayout.HORIZONTAL);
+        h.setGravity(Gravity.CENTER_VERTICAL);
+        FrameLayout disc = new FrameLayout(ctx);
+        GradientDrawable circle = new GradientDrawable();
+        circle.setShape(GradientDrawable.OVAL);
+        circle.setColor(GREEN);
+        disc.setBackground(circle);
+        ImageView bell = new ImageView(ctx);
+        bell.setImageResource(R.drawable.ic_bell);
+        bell.setColorFilter(0xFF06210F);
+        int d = px(30);
+        disc.addView(bell, new FrameLayout.LayoutParams(d * 6 / 10, d * 6 / 10, Gravity.CENTER));
+        LinearLayout.LayoutParams dlp = new LinearLayout.LayoutParams(d, d);
+        dlp.setMarginEnd(px(10));
+        h.addView(disc, dlp);
+        LinearLayout texts = new LinearLayout(ctx);
+        texts.setOrientation(LinearLayout.VERTICAL);
+        title = text(title(now), 17, Color.WHITE, true);
+        sub = text(clock(now), 12, 0xFF98A1B0, false);
+        texts.addView(title);
+        texts.addView(sub);
+        h.addView(texts, new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1));
+        return h;
+    }
+
+    private String title(long now) {
+        String name = card.getString(TimbreService.NAME, "");
+        String kind = card.getString(TimbreService.KIND, TimbreClient.VIEW);
+        if (TimbreClient.RING.equals(kind)) return ctx.getString(R.string.doorbell_ringing, name);
+        if (TimbreClient.MOTION.equals(kind)) return ctx.getString(R.string.motion_title, name);
+        return name;
+    }
+
+    private String clock(long now) {
+        return DateFormat.getTimeFormat(ctx).format(new Date(now));
+    }
+
+    private HoldButton button(String label, int icon, LinearLayout row) {
+        HoldButton b = new HoldButton(ctx, label, icon == 0 ? null : ctx.getDrawable(icon));
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, px(40), 1);
+        if (row.getChildCount() > 0) lp.setMarginStart(px(8));
+        row.addView(b, lp);
+        return b;
+    }
+
+    private TextView text(String s, float sp, int color, boolean medium) {
+        TextView t = new TextView(ctx);
+        t.setText(s);
+        t.setTextSize(sp);
+        t.setTextColor(color);
+        t.setSingleLine(true);
+        t.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        t.setTypeface(Typeface.create(medium ? "sans-serif-medium" : "sans-serif", Typeface.NORMAL));
+        return t;
+    }
+
+    private int px(float dps) {
+        return Math.round(dps * dp);
+    }
+
+    /** A pill button whose outline fills up in green while OK is held, as in the mockup. */
+    private final class HoldButton extends TextView {
+        final String label;
+        int result;   // 0, or the colour of the last opening's answer
+        private float progress;
+        private final Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path path = new Path(), seg = new Path();
+        private final RectF box = new RectF();
+
+        HoldButton(Context c, String label, android.graphics.drawable.Drawable icon) {
+            super(c);
+            this.label = label;
+            setText(label);
+            setTextSize(14);
+            setGravity(Gravity.CENTER);
+            setSingleLine(true);
+            setEllipsize(android.text.TextUtils.TruncateAt.END);
+            setPadding(px(10), 0, px(10), 0);
+            if (icon != null) {
+                icon.setBounds(0, 0, px(16), px(16));
+                setCompoundDrawablesRelative(icon, null, null, null);
+                setCompoundDrawablePadding(px(6));
+            }
+            ring.setStyle(Paint.Style.STROKE);
+            ring.setStrokeWidth(px(3));
+            ring.setColor(GREEN);
+            ring.setStrokeCap(Paint.Cap.ROUND);
+        }
+
+        void setProgress(float p) {
+            progress = p;
+            invalidate();
+        }
+
+        void paint(boolean focused) {
+            GradientDrawable bg = new GradientDrawable();
+            bg.setCornerRadius(px(20));
+            int fill = result != 0 ? result : focused ? INK : 0x14FFFFFF;
+            int ink = result == GREEN ? 0xFF06210F : focused && result == 0 ? 0xFF0B0D12 : Color.WHITE;
+            bg.setColor(fill);
+            setBackground(bg);
+            setTextColor(ink);
+            for (android.graphics.drawable.Drawable d : getCompoundDrawablesRelative()) if (d != null) d.setTint(ink);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            super.onDraw(canvas);
+            if (progress <= 0) return;
+            float w = ring.getStrokeWidth() / 2;
+            box.set(w, w, getWidth() - w, getHeight() - w);
+            path.reset();
+            path.addRoundRect(box, box.height() / 2, box.height() / 2, Path.Direction.CW);
+            PathMeasure pm = new PathMeasure(path, false);
+            seg.reset();
+            pm.getSegment(0, pm.getLength() * progress, seg, true);
+            canvas.drawPath(seg, ring);
+        }
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreClient.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreClient.java
new file mode 100644
index 0000000..b4f43ad
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreClient.java
@@ -0,0 +1,92 @@
+package io.github.ignaciopd3.casa;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.RemoteException;
+
+/**
+ * Casa's side of the doorbell card: binds TimbreService (its own :timbre process, where libwebrtc lives) only while a
+ * card shows, and lets go when the card says it closed, so the process ends and Casa stays small. Binding is allowed
+ * from the background, where starting a service is not (Android 8+, and TCL's firmware). Main thread only.
+ */
+final class TimbreClient implements ServiceConnection {
+    static final String RING = "ring", MOTION = "motion", VIEW = "view";
+    static final int MSG_SHOW = 1, MSG_CLOSED = 2;
+
+    private final Context ctx;
+    private final Messenger replies = new Messenger(new Handler(Looper.getMainLooper(), m -> {
+        if (m.what == MSG_CLOSED) unbind();
+        return true;
+    }));
+    private Messenger service;
+    private Bundle pending;
+    private boolean bound;
+
+    TimbreClient(Context ctx) {
+        this.ctx = ctx;
+    }
+
+    /** Shows a card (TimbreService's keys), or updates the one showing: a new ring, or another doorbell. */
+    void show(Bundle card) {
+        if (service != null) {
+            send(card);
+            return;
+        }
+        pending = card;
+        if (!bound) {
+            bound = ctx.bindService(new Intent(ctx, TimbreService.class), this, Context.BIND_AUTO_CREATE | Context.BIND_IMPORTANT);
+            if (!bound) pending = null;
+        }
+    }
+
+    boolean showing() {
+        return bound;
+    }
+
+    @Override
+    public void onServiceConnected(ComponentName name, IBinder binder) {
+        service = new Messenger(binder);
+        if (pending != null) {
+            send(pending);
+            pending = null;
+        }
+    }
+
+    /** The :timbre process died (or was killed): let go rather than have Android start it again. */
+    @Override
+    public void onServiceDisconnected(ComponentName name) {
+        unbind();
+    }
+
+    private void send(Bundle card) {
+        Message m = Message.obtain(null, MSG_SHOW);
+        m.setData(card);
+        m.replyTo = replies;
+        try {
+            service.send(m);
+        } catch (RemoteException e) {
+            unbind();
+        }
+    }
+
+    void unbind() {
+        if (bound) {
+            try {
+                ctx.unbindService(this);
+            } catch (IllegalArgumentException ignored) {
+                // already let go
+            }
+        }
+        bound = false;
+        service = null;
+        pending = null;
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreService.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreService.java
new file mode 100644
index 0000000..cdbd97f
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreService.java
@@ -0,0 +1,231 @@
+package io.github.ignaciopd3.casa;
+
+import android.app.Service;
+import android.content.Intent;
+import android.media.AudioManager;
+import android.media.ToneGenerator;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.view.KeyEvent;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * The doorbell card, in its own process (:timbre) so libwebrtc's memory goes away with it: the window (TimbreCard),
+ * the camera's live video over Home Assistant (TimbreVideo, HaWebRtc), the opening calls, the pause of whatever was
+ * playing and the close after 90 s (DoorbellRules). Casa binds it while a card shows; when the card closes it tells
+ * Casa, Casa lets go, and onDestroy ends the process.
+ */
+public class TimbreService extends Service implements TimbreCard.Listener, TimbreVideo.Listener {
+    static final String NAME = "name", CAMERA = "camera", KIND = "kind", RING_AT = "ring_at", OPEN_WINDOW_S = "open_window_s",
+            PAUSE = "pause", OPEN_IDS = "open_ids", OPEN_LABELS = "open_labels", OPEN_SERVICES = "open_services";
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private Messenger client;
+    private TimbreCard card;
+    private DoorbellRules rules;
+    private Bundle current;
+    private HaWebRtc rtc;   // worker thread only
+    private TimbreVideo video;
+    private boolean pausedByUs, motionOnly;
+    private long motionUntil;
+    private final Runnable tick = new Runnable() {
+        @Override
+        public void run() {
+            if (card == null) return;
+            long now = System.currentTimeMillis();
+            if (rules.shouldClose(now) || (motionOnly && now >= motionUntil)) {
+                onClose();
+                return;
+            }
+            card.setCanOpen(rules.canOpen(now));
+            main.postDelayed(this, 1000);
+        }
+    };
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return new Messenger(new Handler(Looper.getMainLooper(), this::onMessage)).getBinder();
+    }
+
+    private boolean onMessage(Message m) {
+        if (m.what == TimbreClient.MSG_SHOW) {
+            client = m.replyTo;
+            show(m.getData());
+        }
+        return true;
+    }
+
+    private void show(Bundle b) {
+        long now = System.currentTimeMillis();
+        String kind = b.getString(KIND, TimbreClient.VIEW);
+        boolean sameDoor = card != null && current != null && b.getString(NAME, "").equals(current.getString(NAME));
+        if (sameDoor && TimbreClient.RING.equals(kind)) {   // rung again while looking
+            rules.onRing(now);
+            motionOnly = false;
+            card.ringing(now);
+            chime();
+            return;
+        }
+        if (sameDoor) return;
+        teardown();
+        current = b;
+        motionOnly = TimbreClient.MOTION.equals(kind);
+        motionUntil = now + DoorbellRules.MOTION_VIDEO_MS;
+        rules = new DoorbellRules(b.getInt(OPEN_WINDOW_S, 180), b.getLong(RING_AT, -1), now);
+        card = new TimbreCard(this, b, !motionOnly, this);
+        card.show(now);
+        card.setCanOpen(rules.canOpen(now));
+        if (TimbreClient.RING.equals(kind)) chime();
+        AudioManager am = getSystemService(AudioManager.class);
+        if (!motionOnly && DoorbellRules.shouldPause(b.getBoolean(PAUSE, true), am.isMusicActive())) {
+            mediaKey(am, KeyEvent.KEYCODE_MEDIA_PAUSE);
+            pausedByUs = true;
+        }
+        String camera = b.getString(CAMERA);
+        if (camera != null) startVideo(camera);
+        else card.noVideo();
+        main.postDelayed(tick, 1000);
+    }
+
+    private void startVideo(String camera) {
+        TimbreCard forCard = card;
+        worker.execute(() -> {
+            try {
+                HaWebRtc r = connection();
+                List<Ha.Ice> ice = r.iceServers(camera);
+                main.post(() -> {
+                    if (card != forCard) return;   // closed or switched meanwhile
+                    try {
+                        video = new TimbreVideo(this, card.renderer(), ice, r, camera, this);
+                    } catch (RuntimeException e) {   // libwebrtc could not start on this TV
+                        card.noVideo();
+                    }
+                });
+            } catch (Exception e) {
+                main.post(() -> {
+                    if (card == forCard) card.noVideo();
+                });
+            }
+        });
+    }
+
+    /** The card's own line to Home Assistant, opened once on the worker thread. */
+    private HaWebRtc connection() throws Exception {
+        if (rtc == null) {
+            HaConfig c = Devices.loadHa(this);
+            if (c == null) throw new IllegalStateException("no Home Assistant configuration");
+            rtc = HaWebRtc.open(() -> WebSocket.connect(c.ws, 10_000), c.token);
+        }
+        return rtc;
+    }
+
+    // ---- TimbreCard.Listener ----
+
+    @Override
+    public void onKey() {
+        if (rules != null) rules.onKey(System.currentTimeMillis());
+    }
+
+    @Override
+    public void onOpen(int which) {
+        if (card == null || !rules.canOpen(System.currentTimeMillis())) return;   // the window may have just passed
+        String id = current.getStringArray(OPEN_IDS)[which];
+        String[] service = current.getStringArray(OPEN_SERVICES)[which].split("/", 2);
+        TimbreCard forCard = card;
+        worker.execute(() -> {
+            try {
+                connection().call(service[0], service[1], id, ok -> main.post(() -> {
+                    if (card == forCard) card.opened(which, ok);
+                }));
+            } catch (Exception e) {
+                main.post(() -> {
+                    if (card == forCard) card.opened(which, false);
+                });
+            }
+        });
+    }
+
+    @Override
+    public void onClose() {
+        teardown();
+        if (pausedByUs) {
+            mediaKey(getSystemService(AudioManager.class), KeyEvent.KEYCODE_MEDIA_PLAY);
+            pausedByUs = false;
+        }
+        if (client != null) {
+            try {
+                client.send(Message.obtain(null, TimbreClient.MSG_CLOSED));
+            } catch (RemoteException ignored) {
+                // Casa is gone; the process ends with the binding anyway
+            }
+        }
+    }
+
+    // ---- TimbreVideo.Listener ----
+
+    @Override
+    public void live() {
+        if (card != null) card.live();
+    }
+
+    @Override
+    public void videoFailed() {
+        if (card != null) card.noVideo();
+    }
+
+    // ---- helpers ----
+
+    private void teardown() {
+        main.removeCallbacks(tick);
+        if (video != null) {
+            video.dispose();
+            video = null;
+        }
+        if (card != null) {
+            card.remove();
+            card = null;
+        }
+        current = null;
+        worker.execute(() -> {
+            if (rtc != null) {
+                rtc.close();
+                rtc = null;
+            }
+        });
+    }
+
+    private void chime() {
+        try {
+            ToneGenerator t = new ToneGenerator(AudioManager.STREAM_MUSIC, 80);
+            t.startTone(ToneGenerator.TONE_PROP_BEEP2, 700);
+            main.postDelayed(t::release, 1000);
+        } catch (RuntimeException noAudio) {
+            // no tone on this set: the card still shows
+        }
+    }
+
+    /** Pause or play whatever is playing, through its media session; needs no permission. */
+    private static void mediaKey(AudioManager am, int code) {
+        long t = SystemClock.uptimeMillis();
+        am.dispatchMediaKeyEvent(new KeyEvent(t, t, KeyEvent.ACTION_DOWN, code, 0));
+        am.dispatchMediaKeyEvent(new KeyEvent(t, t, KeyEvent.ACTION_UP, code, 0));
+    }
+
+    @Override
+    public void onDestroy() {
+        teardown();
+        worker.shutdown();
+        super.onDestroy();
+        Process.killProcess(Process.myPid());   // libwebrtc's native memory leaves with the process
+    }
+}
diff --git a/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreVideo.java b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreVideo.java
new file mode 100644
index 0000000..7c5f1d7
--- /dev/null
+++ b/addons/casa/app/src/main/java/io/github/ignaciopd3/casa/TimbreVideo.java
@@ -0,0 +1,184 @@
+package io.github.ignaciopd3.casa;
+
+import android.content.Context;
+import android.media.AudioAttributes;
+import android.os.Handler;
+import android.os.Looper;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import org.webrtc.DataChannel;
+import org.webrtc.DefaultVideoDecoderFactory;
+import org.webrtc.DefaultVideoEncoderFactory;
+import org.webrtc.EglBase;
+import org.webrtc.IceCandidate;
+import org.webrtc.MediaConstraints;
+import org.webrtc.MediaStream;
+import org.webrtc.MediaStreamTrack;
+import org.webrtc.PeerConnection;
+import org.webrtc.PeerConnectionFactory;
+import org.webrtc.RendererCommon;
+import org.webrtc.RtpReceiver;
+import org.webrtc.RtpTransceiver;
+import org.webrtc.SdpObserver;
+import org.webrtc.SessionDescription;
+import org.webrtc.SurfaceViewRenderer;
+import org.webrtc.VideoTrack;
+import org.webrtc.audio.AudioDeviceModule;
+import org.webrtc.audio.JavaAudioDeviceModule;
+
+/**
+ * The camera's live picture and sound through libwebrtc, receive-only, as Home Assistant's own web page gets it: one
+ * peer connection whose offer and candidates go through HaWebRtc. Video is decoded by the TV's hardware decoder
+ * (DefaultVideoDecoderFactory with EGL). Main thread for construction and dispose; libwebrtc calls back on its own
+ * threads, which only post to the main thread.
+ */
+final class TimbreVideo implements HaWebRtc.Peer {
+    interface Listener {
+        void live();
+
+        void videoFailed();
+    }
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final EglBase egl = EglBase.create();
+    private final SurfaceViewRenderer renderer;
+    private final Listener listener;
+    private final PeerConnectionFactory factory;
+    private final PeerConnection pc;
+    private volatile boolean disposed;
+
+    TimbreVideo(Context ctx, SurfaceViewRenderer renderer, List<Ha.Ice> ice, HaWebRtc rtc, String camera, Listener listener) {
+        this.renderer = renderer;
+        this.listener = listener;
+        PeerConnectionFactory.initialize(PeerConnectionFactory.InitializationOptions.builder(ctx.getApplicationContext())
+                .createInitializationOptions());
+        renderer.init(egl.getEglBaseContext(), null);
+        renderer.setScalingType(RendererCommon.ScalingType.SCALE_ASPECT_FIT);
+        renderer.setEnableHardwareScaler(true);
+        // Media, not a call: on a TV the call volume can be low or muted, and the visitor must be heard.
+        AudioDeviceModule adm = JavaAudioDeviceModule.builder(ctx.getApplicationContext())
+                .setAudioAttributes(new AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                        .build())
+                .createAudioDeviceModule();
+        factory = PeerConnectionFactory.builder()
+                .setAudioDeviceModule(adm)
+                .setVideoDecoderFactory(new DefaultVideoDecoderFactory(egl.getEglBaseContext()))
+                .setVideoEncoderFactory(new DefaultVideoEncoderFactory(egl.getEglBaseContext(), true, true))
+                .createPeerConnectionFactory();
+        adm.release();   // the factory keeps its own reference
+
+        List<PeerConnection.IceServer> servers = new ArrayList<>();
+        for (Ha.Ice s : ice) {
+            PeerConnection.IceServer.Builder b = PeerConnection.IceServer.builder(s.urls);
+            if (s.username != null) b.setUsername(s.username);
+            if (s.credential != null) b.setPassword(s.credential);
+            servers.add(b.createIceServer());
+        }
+        PeerConnection.RTCConfiguration conf = new PeerConnection.RTCConfiguration(servers);
+        conf.sdpSemantics = PeerConnection.SdpSemantics.UNIFIED_PLAN;
+        pc = factory.createPeerConnection(conf, new Watcher(rtc));
+        if (pc == null) throw new IllegalStateException("no peer connection");
+        RtpTransceiver.RtpTransceiverInit recvOnly = new RtpTransceiver.RtpTransceiverInit(RtpTransceiver.RtpTransceiverDirection.RECV_ONLY);
+        pc.addTransceiver(MediaStreamTrack.MediaType.MEDIA_TYPE_VIDEO, recvOnly);
+        pc.addTransceiver(MediaStreamTrack.MediaType.MEDIA_TYPE_AUDIO, recvOnly);
+        pc.createOffer(new Sdp() {
+            @Override
+            public void onCreateSuccess(SessionDescription offer) {
+                pc.setLocalDescription(new Sdp() {
+                    @Override
+                    public void onSetSuccess() {
+                        try {
+                            rtc.offer(camera, offer.description, TimbreVideo.this);
+                        } catch (IOException e) {
+                            failed(e.getMessage());
+                        }
+                    }
+                }, offer);
+            }
+        }, new MediaConstraints());
+    }
+
+    // ---- HaWebRtc.Peer (reader thread) ----
+
+    @Override
+    public void answer(String sdp) {
+        if (!disposed) pc.setRemoteDescription(new Sdp(), new SessionDescription(SessionDescription.Type.ANSWER, sdp));
+    }
+
+    @Override
+    public void remoteCandidate(String sdpMid, int sdpMLineIndex, String candidate) {
+        if (!disposed) pc.addIceCandidate(new IceCandidate(sdpMid, sdpMLineIndex, candidate));
+    }
+
+    @Override
+    public void failed(String why) {
+        main.post(() -> {
+            if (!disposed) listener.videoFailed();
+        });
+    }
+
+    void dispose() {
+        if (disposed) return;
+        disposed = true;
+        pc.dispose();
+        renderer.release();
+        factory.dispose();
+        egl.release();
+    }
+
+    /** SdpObserver with nothing to do by default; a failure ends the video. */
+    private class Sdp implements SdpObserver {
+        @Override public void onCreateSuccess(SessionDescription d) { }
+        @Override public void onSetSuccess() { }
+        @Override public void onCreateFailure(String error) { failed(error); }
+        @Override public void onSetFailure(String error) { failed(error); }
+    }
+
+    private final class Watcher implements PeerConnection.Observer {
+        private final HaWebRtc rtc;
+
+        Watcher(HaWebRtc rtc) {
+            this.rtc = rtc;
+        }
+
+        @Override
+        public void onIceCandidate(IceCandidate c) {
+            rtc.localCandidate(c.sdp, c.sdpMid, c.sdpMLineIndex);
+        }
+
+        @Override
+        public void onTrack(RtpTransceiver transceiver) {
+            MediaStreamTrack track = transceiver.getReceiver().track();
+            if (track instanceof VideoTrack) {
+                main.post(() -> {
+                    if (!disposed) ((VideoTrack) track).addSink(renderer);
+                });
+            }
+        }
+
+        @Override
+        public void onConnectionChange(PeerConnection.PeerConnectionState state) {
+            if (state == PeerConnection.PeerConnectionState.CONNECTED) {
+                main.post(() -> {
+                    if (!disposed) listener.live();
+                });
+            } else if (state == PeerConnection.PeerConnectionState.FAILED) {
+                failed("connection failed");
+            }
+        }
+
+        @Override public void onSignalingChange(PeerConnection.SignalingState s) { }
+        @Override public void onIceConnectionChange(PeerConnection.IceConnectionState s) { }
+        @Override public void onIceConnectionReceivingChange(boolean receiving) { }
+        @Override public void onIceGatheringChange(PeerConnection.IceGatheringState s) { }
+        @Override public void onIceCandidatesRemoved(IceCandidate[] candidates) { }
+        @Override public void onAddStream(MediaStream stream) { }
+        @Override public void onRemoveStream(MediaStream stream) { }
+        @Override public void onDataChannel(DataChannel channel) { }
+        @Override public void onRenegotiationNeeded() { }
+        @Override public void onAddTrack(RtpReceiver receiver, MediaStream[] streams) { }
+    }
+}
