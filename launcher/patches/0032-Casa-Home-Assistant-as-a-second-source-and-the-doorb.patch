+package io.github.ignaciopd3.casa;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.widget.Toast;
+
+/**
+ * "Look at the door" from a remote key (the launcher's app_keys): the first doorbell with a camera, live, with open
+ * buttons only if someone rang in the last few minutes. Signature permission, like the light's.
+ */
+public class TimbreActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        CasaService s = CasaService.running();
+        if (s != null) s.lookAtDoor();
+        else Toast.makeText(this, R.string.not_running, Toast.LENGTH_LONG).show();
+        finish();
+    }
+}
