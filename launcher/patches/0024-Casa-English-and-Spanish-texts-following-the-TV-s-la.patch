+/** The door's messages in English and Spanish, MQTT reports and the readings' wording: no Android, no network. */
 public class LogicTest {
     private static final long MIN = 60_000L;
 
+    private static final DoorAlerts.Words EN = words("values", Locale.US), ES = words("values-es", new Locale("es", "ES"));
+
+    /** The module's real strings.xml for a language, as the app's getString would format them. */
+    private static DoorAlerts.Words words(String dir, Locale locale) {
+        try {
+            Map<String, String> byName = strings(dir);
+            Map<Integer, String> byId = new HashMap<>();
+            for (Field f : R.string.class.getFields()) byId.put(f.getInt(null), byName.get(f.getName()));
+            return (id, args) -> String.format(locale, byId.get(id), args);
+        } catch (Exception e) {
+            throw new AssertionError(e);
