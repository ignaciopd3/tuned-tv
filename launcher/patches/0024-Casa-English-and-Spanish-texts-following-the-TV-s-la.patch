+    }
+
+    /** name → text of src/main/res/<dir>/strings.xml (plurals as "plurals:<name>", their "other" form). */
+    private static Map<String, String> strings(String dir) throws Exception {
+        org.w3c.dom.Document doc = javax.xml.parsers.DocumentBuilderFactory.newInstance().newDocumentBuilder()
+                .parse(new java.io.File("src/main/res/" + dir + "/strings.xml"));
+        Map<String, String> out = new TreeMap<>();
+        org.w3c.dom.NodeList ss = doc.getElementsByTagName("string");
+        for (int i = 0; i < ss.getLength(); i++) {
+            org.w3c.dom.Element e = (org.w3c.dom.Element) ss.item(i);
+            out.put(e.getAttribute("name"), e.getTextContent().replace("\\'", "'").replace("\\\"", "\""));
+        }
+        org.w3c.dom.NodeList ps = doc.getElementsByTagName("item");
+        for (int i = 0; i < ps.getLength(); i++) {
+            org.w3c.dom.Element e = (org.w3c.dom.Element) ps.item(i);
+            if (!"other".equals(e.getAttribute("quantity"))) continue;
+            String name = ((org.w3c.dom.Element) e.getParentNode()).getAttribute("name");
+            out.put("plurals:" + name, e.getTextContent());
+        }
+        return out;
+    }
+
+    private static List<String> placeholders(String text) {
+        List<String> out = new ArrayList<>();
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile("%\\d+\\$[sd]").matcher(text);
+        while (m.find()) out.add(m.group());
+        java.util.Collections.sort(out);
+        return out;
+    }
