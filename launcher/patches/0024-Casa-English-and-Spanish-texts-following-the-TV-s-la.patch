 package io.github.ignaciopd3.casa;
 
 /**
- * What the door sensor's changes should say: "Puerta abierta", then "La puerta sigue abierta" every five minutes
- * while it stays open (and when the TV is switched on with it open), and "Puerta cerrada" with how long it was open.
- * The first reading only learns the state; repeated reports of the same state say nothing.
+ * What the door sensor's changes should say: "door open", then "still open" every five minutes while it stays open
+ * (and when the TV is switched on with it open), and "door closed" with how long it was open. The first reading only
+ * learns the state; repeated reports of the same state say nothing. The words come from the app's strings, in the
+ * TV's language.
  */
 class DoorAlerts {
     static final long REMIND_MS = 5 * 60_000L;
 
+    /** The app's texts by resource id: Context::getString in the app, the strings.xml files in the tests. */
+    interface Words {
+        String get(int id, Object... args);
+    }
+
+    enum Kind { OPEN, STILL_OPEN, CLOSED }
+
     static final class Alert {
-        final boolean closed;
-        final String title, sub;
+        final Kind kind;
+        final long minutes;   // how long the door has been (or was) open
+
+        Alert(Kind kind, long minutes) {
+            this.kind = kind;
+            this.minutes = minutes;
+        }
 
-        Alert(boolean closed, String title, String sub) {
-            this.closed = closed;
-            this.title = title;
-            this.sub = sub;
+        String title(Words w) {
+            switch (kind) {
+                case OPEN: return w.get(R.string.door_open);
+                case STILL_OPEN: return w.get(R.string.door_still_open);
+                default: return w.get(R.string.door_closed);
+            }
+        }
+
+        String sub(Words w) {
+            switch (kind) {
+                case OPEN: return w.get(R.string.door_open_sub);
+                case STILL_OPEN: return w.get(R.string.door_still_open_sub, duration(w, minutes));
+                default: return w.get(R.string.door_closed_sub, duration(w, minutes));
+            }
         }
     }
 
@@ -39,9 +62,9 @@ class DoorAlerts {
         if (isOpen) {
             openedAt = now;
             lastReminderAt = now;
-            return new Alert(false, "Puerta abierta", "El sensor de la puerta se ha abierto");
+            return new Alert(Kind.OPEN, 0);
         }
-        return new Alert(true, "Puerta cerrada", "Estuvo abierta " + duration(now - openedAt));
+        return new Alert(Kind.CLOSED, (now - openedAt) / 60_000L);
     }
 
     /** Called at nextTickAt(): the five-minute reminder while the door stays open. */
@@ -61,16 +84,14 @@ class DoorAlerts {
     }
 
     private Alert stillOpen(long now) {
-        long min = Math.max(1, (now - openedAt) / 60_000L);
-        return new Alert(false, "La puerta sigue abierta", "Desde hace " + minutes(min) + " · te lo recuerdo cada 5 min");
-    }
-
-    static String duration(long ms) {
-        long min = ms / 60_000L;
-        return min < 1 ? "menos de un minuto" : minutes(min);
+        return new Alert(Kind.STILL_OPEN, Math.max(1, (now - openedAt) / 60_000L));
     }
 
-    private static String minutes(long min) {
-        return min < 60 ? min + " min" : (min / 60) + " h" + (min % 60 == 0 ? "" : " " + (min % 60) + " min");
+    /** "less than a minute", "12 min", "1 h", "1 h 10 min", in the TV's language. */
+    static String duration(Words w, long min) {
+        if (min < 1) return w.get(R.string.duration_under_minute);
+        if (min < 60) return w.get(R.string.duration_minutes, min);
+        return min % 60 == 0 ? w.get(R.string.duration_hours, min / 60)
+                : w.get(R.string.duration_hours_minutes, min / 60, min % 60);
     }
 }
