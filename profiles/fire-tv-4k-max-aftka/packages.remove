# Fire TV Stick 4K Max (AFTKA, Fire OS 7.7.1.3). Todo se DESHABILITA (este firmware no tiene install-existing, así que
# no se desinstala nada) y es reversible con --action rollback.
# Fuente: dumbtv (MIT), catálogo fireos-amazon-aftka-ps7713, probado en tres sticks con este mismo firmware.
# Elegido para este perfil (2026-11-23): limpieza básica entera, sin Alexa y sin las apps de Amazon de menos uso.
# Los que dumbtv lista y aquí no están (no vienen en este modelo) se omiten solos con un aviso.
# Limpieza básica: anuncios, telemetría, ACR (reconoce lo que se ve, también por HDMI), promos y actualizaciones forzadas
com.amazon.hybridadidservice                   # advertising ID
com.amazon.privacypassservice                  # ad-token service
com.amazon.shoptv.client                       # shopping on the TV
com.amazon.shoptv.firetv.client                # "Amazon Live Shopping" tile
com.amazon.sneakpeek                           # autoplaying promos
com.amazon.media.recommendations               # sponsored rows
com.amazon.systemnotices                       # Amazon promo notices
com.amazon.tv.website_launcher                 # promo web pages
com.amazon.tv.acr                              # Automatic Content Recognition: fingerprints the screen, HDMI included
com.amazon.hedwig                              # watch time and engagement
com.amazon.tv.fw.metrics
com.amazon.wirelessmetrics.service
com.amazon.perfc
com.amazon.perfcollection
com.amazon.dp.logger
com.amazon.logan
com.amazon.neo.minerva.logcat
com.amazon.ceviche                             # analytics pipeline, uploads to unagi-*.amazon.com
com.amazon.connectivitydiag
com.amazon.tigris
com.amazon.tv.developer.dataservice
com.amazon.ale
com.amazon.katoch
com.amazon.device_remote_config_sync_service
com.amazon.tv.forcedotaupdater.v2
com.amazon.tv.easyupgrade
com.amazon.tv.democontent.provider
com.amazon.tmm.tutorial
com.amazon.tv.releasenotes
com.amazon.dummy.alarmclock
com.amazon.dummy.calendar
com.amazon.dummy.contacts
com.amazon.dummy.gallery
com.amazon.dummy.music
com.amazon.dummy.settings
com.android.traceur                            # system tracing tool
com.android.nfc                                # no NFC hardware on Fire TV
# Alexa (el botón del micro del mando deja de hacer nada)
com.amazon.aca                                 # the app that owns the microphone
com.amazon.alexa.datastore.app
com.amazon.alexadirectivebrokerservice
com.amazon.alexamediaplayer.runtime.ftv
com.amazon.alexa.externalmediaplayer.fireos
com.amazon.tv.alexaalerts
com.amazon.tv.alexanotifications
com.amazon.vizzini.ftvcds
com.amazon.firetv.androidskillconnectioncapability
com.amazon.audiohome
com.amazon.rtcsessioncontroller                # Alexa calling
com.amazon.smarthomemapviewapp                 # "Alexa Smart Home" dashboard
com.amazon.spotify.mediabrowserservice         # lets Alexa play Spotify
com.amazon.wha.mediabrowserservice             # Alexa multi-room audio
com.amazon.aria                                # Alexa visual cards
com.amazon.whad                                # Alexa multi-room audio (Fire OS 6, and the Fire TV Cube on 7)
com.amazon.whasettings                         # Fire OS 6, and the Fire TV Cube on 7
# Apps de Amazon de menos uso
com.amazon.bueller.music                       # Amazon Music
com.amazon.bueller.photos                      # Amazon Photos
com.amazon.gamehub                             # Juegos
com.amazon.spiderpork                          # Luna (juego en la nube)
com.amazon.cloud9                              # Silk (navegador)
com.amazon.tahoe                               # Amazon Kids
com.amazon.tv.support                          # Ayuda
com.android.printspooler                       # impresión
com.android.bips                               # impresión
com.amazon.minitv.android.app                  # miniTV (canal gratis con anuncios)
# Con el inicio limpio (2026-11-23), de la lista opcional de dumbtv:
com.amazon.ftv.screensaver                     # salvapantallas de Amazon: lo sustituye el reloj del launcher (ClockDream)
com.amazon.tv.ottssocompanionapp               # iniciar sesión con un proveedor de TV (no existe en España)
