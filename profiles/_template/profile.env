# Plantilla de perfil. Copia esta carpeta a profiles/<marca>-<modelo>-<soc>/ y rellena cada fichero.
#
# Identificación: elige una propiedad que distinga ESTE firmware. ro.product.model suele ser genérico
# (TCL: «Smart TV Pro»). Para verla:
#   adb shell getprop | grep -iE "product|board|hardware|client_type|fingerprint"
# Ejemplos: TCL → persist.tcl.client_type · general → ro.product.name o ro.build.fingerprint.
# Con el valor CAMBIAR el motor se niega a tocar ninguna TV (salida 3) hasta que lo rellenes.
PROFILE_NAME="Marca Modelo · SoC · región"
MATCH_PROP=ro.product.name
MATCH_VALUE=CAMBIAR

# Informativos (documentación del perfil):
ABI=armeabi-v7a            # adb shell getprop ro.product.cpu.abilist
WIFI_COUNTRY=ES            # adb shell cmd wifi get-country-code
